local function shelfVisible(model)
	local plot = myPlot()
	local p = model
	while p and p ~= workspace and p ~= plot do
		if p:GetAttribute("Locked") == true or p:GetAttribute("Hidden") == true or p:GetAttribute("RemodelSwapped") == true then return false end
		p = p.Parent
	end
	return not remodelHidden(model, plot)
