local function findThief()
	local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	local uid = lp.UserId
	-- get plot bounds once for position check
	local bmn, bmx = plotBounds()
	local function inMyStore(m)
		-- 1. explicit owner attribute (fastest)
		local oid = m:GetAttribute("SukiOwnerId") or m:GetAttribute("OwnerUserId")
			or m:GetAttribute("PlotOwnerUserId") or m:GetAttribute("StoreOwnerUserId")
		if oid ~= nil then return oid == uid end
		-- 2. position inside my plot bounds (expanded by 6 studs to cover doorways)
		if bmn and bmx and m:FindFirstChild("HumanoidRootPart") then
			local pos = m.HumanoidRootPart.Position
			return pos.X >= bmn.X-6 and pos.X <= bmx.X+6
				and pos.Z >= bmn.Z-6 and pos.Z <= bmx.Z+6
		end
		return false
	end
	local best, bestD
	for _, m in ipairs(workspace:GetChildren()) do
		if m:IsA("Model") and m:FindFirstChildOfClass("Humanoid") and m:FindFirstChild("HumanoidRootPart")
			and not Players:GetPlayerFromCharacter(m) and isThief(m) and inMyStore(m) then
			local d = root and (m.HumanoidRootPart.Position - root.Position).Magnitude or 0
			if not bestD or d < bestD then best, bestD = m, d end
		end
	end
	return best
end

