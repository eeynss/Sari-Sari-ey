function Section:AddSlider(o)
	local row, wrap = self:_row(o.Name, 42, 158)
	local ui = self.Tab.Ui
	local name = label(row, o.Name, 12, C.text, false)
	name.Size = UDim2.new(1, -60, 0, wrap and 34 or 20)
	wrapName(name, wrap)
	local val = label(row, "", 12, C.pink, true)
	val.Size, val.Position, val.TextXAlignment = UDim2.fromOffset(56, 20), UDim2.new(1, -56, 0, 0), Enum.TextXAlignment.Right
	local track = new("Frame", { Size = UDim2.new(1, 0, 0, 5), Position = UDim2.fromOffset(0, wrap and 43 or 29), BackgroundColor3 = C.card, BackgroundTransparency = 0.8, BorderSizePixel = 0 }, row)
	round(track, 3)
	local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.pink, BorderSizePixel = 0 }, track)
	round(fill, 3)
	new("UIGradient", { Color = ColorSequence.new(C.pink, C.pink2) }, fill)
	local knob = new("Frame", { Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, track)
	round(knob, 6)
	local min, max, dec = o.Min or 0, o.Max or 100, o.Decimals or 0
	local value
	local function set(v, animate)
		local m = 10 ^ dec
		v = math.clamp(math.floor(v * m + 0.5) / m, min, max)
		value = v
		val.Text = tostring(v)
		local a = (v - min) / (max - min)
		local t = animate and 0.12 or 0
		tween(fill, t, { Size = UDim2.fromScale(a, 1) })
		tween(knob, t, { Position = UDim2.fromScale(a, 0.5) })
		if o.Flag then ui.Flags[o.Flag] = v end
		if o.Callback then task.spawn(o.Callback, v) end
	end
	set(o.Default or min, false)
	local obj = { Set = function(_, v) set(v, true) end }
	if o.Flag then ui.Elements[o.Flag] = obj end
	local drag = false
	local function fromX(x) set(min + math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1) * (max - min), true) end
	track.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			drag = true
			tween(knob, 0.15, { Size = UDim2.fromOffset(16, 16) })
			fromX(i.Position.X)
		end
	end)
	table.insert(ui.Conns, UIS.InputChanged:Connect(function(i)
		if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then fromX(i.Position.X) end
	end))
	table.insert(ui.Conns, UIS.InputEnded:Connect(function(i)
		if drag and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
			drag = false
			tween(knob, 0.2, { Size = UDim2.fromOffset(12, 12) })
		end
	end))
	return obj
end

-- text box row; Numeric keeps only digits. Callback(text) fires on enter / click away.
function Section:AddInput(o)
	local row, wrap = self:_row(o.Name, 30, 90)
	local ui = self.Tab.Ui
	local name = label(row, o.Name, 12, C.text, false)
	name.Size = UDim2.new(0.42, 0, 1, 0)
	wrapName(name, wrap)
	local holder = new("Frame", { Size = UDim2.new(0.58, 0, 1, -4), Position = UDim2.new(0.42, 0, 0, 2) }, row)
	glass(holder, 8, 0.7, 0.8)
	local box = new("TextBox", {
		BackgroundTransparency = 1, Size = UDim2.new(1, -14, 1, 0), Position = UDim2.fromOffset(7, 0), Text = o.Default or "", PlaceholderText = o.Placeholder or "",
		PlaceholderColor3 = C.muted, TextColor3 = C.text, Font = Enum.Font.Gotham, TextSize = 12, ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left,
	}, holder)
	local obj = {}
	function obj:Set(v, silent) box.Text = tostring(v or "") if not silent and o.Callback then task.spawn(o.Callback, box.Text) end end
	function obj:Get() return box.Text end
	if o.Numeric then
		box:GetPropertyChangedSignal("Text"):Connect(function()
			local t = box.Text:gsub("%D", "")
			if t ~= box.Text then box.Text = t end
		end)
	end
	box.Focused:Connect(function() tween(holder, 0.15, { BackgroundTransparency = 0.5 }) end)
	box.FocusLost:Connect(function()
		tween(holder, 0.15, { BackgroundTransparency = 0.7 })
		if o.Flag then ui.Flags[o.Flag] = box.Text end
		if o.Callback then task.spawn(o.Callback, box.Text) end
	end)
	if o.Flag then ui.Flags[o.Flag] = box.Text ui.Elements[o.Flag] = obj end
	return obj
end

-- dropdown: popup list drawn above the window; obj:SetOptions(list), obj:Set(value), obj:Get()
function Section:AddDropdown(o)
	local row, wrap = self:_row(o.Name, 30, 90)
	local ui = self.Tab.Ui
	local name = label(row, o.Name, 12, C.text, false)
	name.Size = UDim2.new(0.42, 0, 1, 0)
	wrapName(name, wrap)
	local btn = new("TextButton", { Size = UDim2.new(0.58, 0, 1, -4), Position = UDim2.new(0.42, 0, 0, 2), Text = "", AutoButtonColor = false }, row)
	glass(btn, 8, 0.7, 0.8)
	local cur = label(btn, "", 12, C.text, false)
	cur.Size, cur.Position = UDim2.new(1, -28, 1, 0), UDim2.fromOffset(9, 0)
	local arrow = new("TextLabel", { BackgroundTransparency = 1, Text = "▾", TextSize = 14, TextColor3 = C.muted, Font = Enum.Font.GothamBold, Size = UDim2.fromOffset(20, 26), Position = UDim2.new(1, -22, 0, 0) }, btn)
	local options, value = o.Options or {}, o.Default
	local obj = {}
	local popup
	local function close()
		if popup then
			local p = popup
			popup = nil
			tween(arrow, 0.2, { Rotation = 0 })
			tween(p.F, 0.18, { GroupTransparency = 1 }).Completed:Once(function() p.Catcher:Destroy() end)
		end
	end
	function obj:Get() return value end
	function obj:Set(v, silent)
		value = v
		cur.Text = tostring(v or "-")
		if o.Flag then ui.Flags[o.Flag] = v end
		if not silent and o.Callback then task.spawn(o.Callback, v) end
	end
	function obj:SetOptions(list, keep)
		options = list
		if not keep then obj:Set(list[1], true) end
	end
	obj:Set(value, true)
	btn.MouseButton1Click:Connect(function()
		if popup then close() return end
		local catcher = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 300, AutoButtonColor = false }, ui.Gui)
		catcher.MouseButton1Click:Connect(close)
		local rows = math.min(#options, 6)
		local f = new("CanvasGroup", { Size = UDim2.fromOffset(btn.AbsoluteSize.X, rows * 26 + 8), Position = UDim2.fromOffset(btn.AbsolutePosition.X, btn.AbsolutePosition.Y + btn.AbsoluteSize.Y + 4), GroupTransparency = 1, ZIndex = 301 }, catcher)
		glass(f, 10, 0.2, 0.55)
		local sc = new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, -8, 1, -8), Position = UDim2.fromOffset(4, 4), ScrollBarThickness = 2, ScrollBarImageColor3 = C.pink, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 302 }, f)
		new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, sc)
		for i, opt in ipairs(options) do
			local b = new("TextButton", { Size = UDim2.new(1, -4, 0, 26), Text = tostring(opt), Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = opt == value and C.pink or C.text, BackgroundColor3 = C.card, BackgroundTransparency = 1, AutoButtonColor = false, LayoutOrder = i, ZIndex = 303 }, sc)
			round(b, 7)
			pad(b, 8, 0)
			b.MouseEnter:Connect(function() tween(b, 0.1, { BackgroundTransparency = 0.8 }) end)
			b.MouseLeave:Connect(function() tween(b, 0.1, { BackgroundTransparency = 1 }) end)
			b.MouseButton1Click:Connect(function() obj:Set(opt) close() end)
		end
		popup = { F = f, Catcher = catcher }
		tween(f, 0.18, { GroupTransparency = 0 })
		tween(arrow, 0.2, { Rotation = 180 })
	end)
	if o.Flag then ui.Elements[o.Flag] = obj end
	return obj
end

-- keybind: click, then press a key (Esc cancels). Callback(KeyCode)
function Section:AddKeybind(o)
	local row = self:_row(o.Name, 30)
	local name = label(row, o.Name, 12, C.text, false)
	name.Size = UDim2.new(0.6, 0, 1, 0)
	local btn = new("TextButton", { Size = UDim2.fromOffset(86, 24), Position = UDim2.new(1, -86, 0.5, -12), Text = "", AutoButtonColor = false }, row)
	glass(btn, 8, 0.7, 0.8)
	local txt = new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = C.muted }, btn)
	local key = o.Default
	local obj = {}
	local function show() txt.Text = key and key.Name or "None" end
	function obj:Set(k, silent)
		key = k
		show()
		if not silent and o.Callback then task.spawn(o.Callback, k) end
	end
	show()
	btn.MouseButton1Click:Connect(function()
		txt.Text = "press a key..."
		txt.TextColor3 = C.pink
		local c
		c = UIS.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.Keyboard then
