local function snapshot()
	local data = { H = {}, theme = themeState, real = {}, fake = {}, key = ui.ToggleKey.Name, buyItems = {}, furniture = {}, lic = ui.Flags.RestockLicenseText or "all" }
	for id in pairs(H.AutoBuyItems) do table.insert(data.buyItems, id) end
	for k in pairs(H.FurnitureWanted) do table.insert(data.furniture, k) end
	for k, v in pairs(H) do
		if type(v) == "boolean" or type(v) == "number" then data.H[k] = v end
	end
	for id in pairs(RealImages) do table.insert(data.real, id) end
	for id in pairs(FakeImages) do table.insert(data.fake, id) end
	return data
end

local function applyData(data)
	if type(data) ~= "table" then return false end
	for k, v in pairs(data.H or {}) do
		if type(H[k]) == type(v) or DEFAULTS[k] ~= nil then
			H[k] = v
			local el = ui.Elements[k]
			if el then el:Set(v, true) end
		end
	end
	local t = data.theme
	if type(t) == "table" then
		if PRESETS[t.preset] then presetDrop:Set(t.preset, true) ui:SetTheme(PRESETS[t.preset][1], PRESETS[t.preset][2]) themeState.preset = t.preset end
		if type(t.transparent) == "boolean" then themeState.transparent = t.transparent ui:SetTransparent(t.transparent) if ui.Elements.ThemeTransparent then ui.Elements.ThemeTransparent:Set(t.transparent, true) end end
		if type(t.skeleton) == "boolean" then themeState.skeleton = t.skeleton ui:SetSkeleton(t.skeleton) if ui.Elements.ThemeSkeleton then ui.Elements.ThemeSkeleton:Set(t.skeleton, true) end end
		if type(t.scale) == "number" then themeState.scale = t.scale ui:SetScale(t.scale / 100) if ui.Elements.ThemeScale then ui.Elements.ThemeScale:Set(t.scale) end end
	end
	if type(data.buyItems) == "table" then H.AutoBuyItems = {} for _, id in ipairs(data.buyItems) do H.AutoBuyItems[id] = true end refreshPicked() end
	if type(data.lic) == "string" and ui.Elements.RestockLicenseText then ui.Elements.RestockLicenseText:Set(data.lic) end
	if type(data.furniture) == "table" then H.FurnitureWanted = {} for _, k in ipairs(data.furniture) do H.FurnitureWanted[k] = true end refreshFurniture() end
	for _, id in ipairs(data.real or {}) do RealImages[id] = true end
	for _, id in ipairs(data.fake or {}) do FakeImages[id] = true end
	if data.key and Enum.KeyCode[data.key] then ui:SetToggleKey(Enum.KeyCode[data.key]) end
	return true
end

local loadedName, autoName = "none", "none"
local function status() cfgStatus:Set(("loaded: %s  |  autoload: %s"):format(loadedName, autoName)) end

local function listConfigs()
	local names = {}
	if fsOk and type(listfiles) == "function" then
		pcall(function()
			for _, f in ipairs(listfiles(CFG)) do
				local n = f:match("([^/\\]+)%.json$")
				if n then table.insert(names, n) end
			end
		end)
	end
	table.sort(names)
	if #names == 0 then names = { "-" } end
	return names
end
local function refresh(select)
	local names = listConfigs()
	cfgDrop:SetOptions(names, true)
	cfgDrop:Set(select or (table.find(names, cfgDrop:Get()) and cfgDrop:Get()) or names[1], true)
end
local function pathOf(n) return CFG .. "/" .. n .. ".json" end
local function cleanName(n) return (tostring(n or ""):gsub("[^%w_%- ]", ""):gsub("^%s+", ""):gsub("%s+$", "")) end

local function saveAs(n)
	n = cleanName(n)
	if n == "" or not fsOk then cfgStatus:Set("Type a config name first.") return end
	local ok = pcall(function() writefile(pathOf(n), HttpService:JSONEncode(snapshot())) end)
	if ok then loadedName = n refresh(n) status() else cfgStatus:Set("Could not write the file.") end
end

cfgName:AddButton({ Name = "Create / Save new", Callback = function() saveAs(nameInput:Get()) end })
cfgName:AddButton({ Name = "Save over selected", Callback = function() if cfgDrop:Get() ~= "-" then saveAs(cfgDrop:Get()) end end })
cfgName:AddButton({ Name = "Load selected", Callback = function()
	local n = cfgDrop:Get()
	if not fsOk or n == "-" then return end
	local ok, data = pcall(function() return HttpService:JSONDecode(readfile(pathOf(n))) end)
	if ok and applyData(data) then loadedName = n status() else cfgStatus:Set("Could not load that config.") end
end })
cfgName:AddButton({ Name = "Delete selected", Callback = function()
	local n = cfgDrop:Get()
	if fsOk and n ~= "-" and type(delfile) == "function" then pcall(delfile, pathOf(n)) if loadedName == n then loadedName = "none" end refresh() status() end
end })
