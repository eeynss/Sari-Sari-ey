	local options, selected = o.Options or {}, {}
	for k, v in pairs(o.Selected or {}) do selected[k] = v end
	local obj = {}
	local popup

	local function summary()
		local n, first = 0, nil
		for k in pairs(selected) do n = n + 1 first = first or k end
