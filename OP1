local function walkNear(targetPos, within)
	local ch = lp.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not (root and hum) then return false end
	if not H.RestockMove or userMoving() then return false end
	local moved = false
	local function dist() return (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(targetPos.X, 0, targetPos.Z)).Magnitude end
	if dist() <= within then return true end

	local deadline = os.clock() + 30
	-- bigger stores (expansions) have narrower aisles and more floors: try a normal agent first, then a slimmer one
	local path, ok
	if dist() >= 14 then
		for _, radius in ipairs({ 2, 1 }) do
			path = PFS:CreatePath({ AgentRadius = radius, AgentHeight = 5, AgentCanJump = true })
			ok = pcall(function() path:ComputeAsync(root.Position, targetPos) end)
			if ok and path.Status == Enum.PathStatus.Success then break end
		end
	end
	if ok and path.Status == Enum.PathStatus.Success then
		for i, wp in ipairs(path:GetWaypoints()) do
			if i > 1 then
				if not (alive and H.RestockMove and (H.AutoRestock or H.AutoTrashEmpty or H.AutoParcel)) or os.clock() > deadline or userMoving() then break end
				if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
				moved = true
				hum:MoveTo(wp.Position)
				local t0 = os.clock()
				while os.clock() - t0 < 2.5 and (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(wp.Position.X, 0, wp.Position.Z)).Magnitude > 2.5 do
					task.wait(0.05)
				end
				if dist() <= within then break end
			end
		end
	end
	-- last stretch (or no route): walk straight at it until close enough
	local t0 = os.clock()
	while dist() > within and os.clock() - t0 < 3 and alive and H.RestockMove and not userMoving() do
		moved = true
		hum:MoveTo(targetPos)
		task.wait(0.1)
	end
	if moved and not userMoving() then hum:MoveTo(root.Position) end
	return dist() <= within + 1
end

local function goNear(partOrPos)
	if not (H.RestockMove and partOrPos) then return end
	local pos = typeof(partOrPos) == "Vector3" and partOrPos or (typeof(partOrPos) == "Instance" and partOrPos:IsA("BasePart") and partOrPos.Position) or nil
	if not pos then return end
	if typeof(tripHome) ~= "Vector3" then
		local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
		tripHome = root and root.Position or true
	end
	walkNear(pos, 5)
end
local function endTrip()
	local start = tripHome
	tripHome = nil
	if typeof(start) ~= "Vector3" or not (H.ReturnToRegister and H.RestockMove) then return end
	local plot = myPlot()
	if not plot then return end
	local best, bd
	for _, p in ipairs(scanPrompts(plot).reg) do
		local part = p.Parent
		local model = p:FindFirstAncestorWhichIsA("Model")
		if part and part:IsA("BasePart") and (not model or shelfVisible(model)) then
			local d = (part.Position - start).Magnitude
			if not bd or d < bd then best, bd = part.Position, d end
		end
	end
	if best then pcall(walkNear, best, 6) end
end

-- a shelf counts only if it is in a part of your store that exists: sections you have not built are marked Locked / Hidden on an
-- ancestor model (e.g. "Expansion 2"), and remodelled sections are RemodelSwapped. (Checking part transparency was wrong: most
-- fridge/candy shelves are made of invisible hit-boxes, so it rejected perfectly good shelves.)

local function pickupBox()
	local plot = myPlot()
	local bay = plot and plot:FindFirstChild("TruckBay")
	local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	if not (bay and root) then return false end
	local list = {}
	for _, d in ipairs(bay:GetChildren()) do
		if d.Name == "DeliveryBox" and (d:GetAttribute("Count") or 0) > 0 and licenseAllowed(d:GetAttribute("ProductId")) then
			local prompt = d:FindFirstChild("PickupPrompt", true)
			if prompt then table.insert(list, { box = d, prompt = prompt }) end
		end
	end
	if #list == 0 then return false end
	local function fire(prompt)
		local was = prompt.Enabled
		prompt.Enabled = true
		fireproximityprompt(prompt)
		prompt.Enabled = was
	end
	for _, e in ipairs(list) do fire(e.prompt) end
	local t0 = os.clock()
	local function remaining()
		local n = 0
		for _, e in ipairs(list) do if e.box.Parent and (e.box:GetAttribute("Count") or 0) > 0 then n = n + 1 end end
		return n
	end
	while remaining() > 0 and os.clock() - t0 < 0.3 do task.wait() end
	if remaining() > 0 then
		for _, e in ipairs(list) do
			if e.box.Parent and (e.box:GetAttribute("Count") or 0) > 0 then
				goNear(e.prompt.Parent)
				fire(e.prompt)
				task.wait()
			end
		end
	end
	stats.actions = stats.actions + 1
	onStats()
	return true
end

-- Empty boxes: once a box is used up it stays in your backpack as "Empty Box" (IsEmptyBox). Equip it, walk to the nearest trash
-- can and use its "Throw Away" TrashPrompt. (Only empty boxes: a box with products would pop the game's confirm dialog.)
local function emptyBoxes()
	local list = {}
	for _, holder in ipairs({ lp.Character, lp.Backpack }) do
		if holder then
			for _, t in ipairs(holder:GetChildren()) do
				if t:IsA("Tool") and t:GetAttribute("IsRestockBox") and t:GetAttribute("IsEmptyBox") == true then table.insert(list, t) end
			end
		end
	end
	return list
end

local trashRetryAt = 0
local function trashEmpties()
	if os.clock() < trashRetryAt then return false end
	local boxes = emptyBoxes()
	if #boxes == 0 then return false end
	local ch = lp.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	local plot = myPlot()
	if not (hum and root and plot) then return false end

	local best, bestD
	for _, p in ipairs(plot:GetDescendants()) do
		if p:IsA("ProximityPrompt") and p.Name == "TrashPrompt" then
			local can = p:FindFirstAncestorWhichIsA("Model")
			if can and shelfVisible(can) then
				local partPos = p.Parent and p.Parent:IsA("BasePart") and p.Parent.Position or can:GetPivot().Position
				local d = (partPos - root.Position).Magnitude
				if not bestD or d < bestD then best, bestD = p, d end
			end
		end
	end
	if not best then trashRetryAt = os.clock() + 10 return false end

	local function fire()
		local was = best.Enabled
		best.Enabled = true
		fireproximityprompt(best)
		best.Enabled = was
	end
	local walked = false
	local threw = 0
	for _ = 1, 12 do
		local list = emptyBoxes()
		if #list == 0 then break end
		local before = #list
		local box = list[1]
		if box.Parent ~= ch then
			hum:EquipTool(box)
			local te = os.clock()
			while box.Parent ~= ch and os.clock() - te < 0.3 do task.wait() end
		end
		fire()
		local t0 = os.clock()
		while #emptyBoxes() >= before and os.clock() - t0 < 0.25 do task.wait() end
		if #emptyBoxes() >= before and not walked then
			walked = true
			goNear(best.Parent and best.Parent:IsA("BasePart") and best.Parent or nil)
			fire()
			t0 = os.clock()
			while #emptyBoxes() >= before and os.clock() - t0 < 0.4 do task.wait() end
		end
		if #emptyBoxes() >= before then break end
		threw = threw + 1
	end
	stats.actions = stats.actions + 1
	onStats()
	if threw == 0 then
		trashRetryAt = os.clock() + 10
		hum:UnequipTools()
		return false
	end
	return true
end

local skip = {}
-- empties the equipped box shelf by shelf (nearest next); returns true if it placed anything
local boxFail = setmetatable({}, { __mode = "k" }) -- box -> time until which we leave it alone (nothing fits it)

-- which shelf should this product go on? A shelf is "needy" when it is empty or down to H.RestockBelow items (default 1) --
-- we do not top up shelves that still have plenty. Same-product shelves come first, then an empty shelf of the right category.
-- scanning the whole plot every tick is slow; the list of shelves rarely changes, so rescan it every few seconds only
local shelfCache = { t = 0 }
local function shelfData(plot)
	if shelfCache.plot ~= plot or os.clock() - shelfCache.t > 2 or shelfCache.tier ~= plot:GetAttribute("StoreLayoutTier") then
		local prompts, models = {}, {}
		for _, d in ipairs(plot:GetDescendants()) do
			if d:IsA("ProximityPrompt") and d.Name == "RestockPrompt" then table.insert(prompts, d)
			elseif d:IsA("Model") and d:GetAttribute("ShelfId") then table.insert(models, d) end
		end
		shelfCache.plot, shelfCache.t, shelfCache.prompts, shelfCache.models, shelfCache.tier = plot, os.clock(), prompts, models, plot:GetAttribute("StoreLayoutTier")
	end
	return shelfCache
end


local function chooseShelf(plot, rootPos, id, wantCat)
	local limit = wantCat == "rice" and 1 or math.max(1, H.ShelvesPerItem or 1)
	local data = shelfData(plot)
	local holding = 0
	for _, m in ipairs(data.models) do
		if m.Parent and m:GetAttribute("ProductId") == id then holding = holding + 1 end
	end
	local best, bestScore
	for _, p in ipairs(data.prompts) do
		local model = p.Parent and shelfModelOf(p)
		if model and not skip[model] and (model:GetAttribute("Category") or "general") == wantCat and shelfVisible(model) then
			local stock, cap = model:GetAttribute("Stock") or 0, model:GetAttribute("Capacity") or 0
			local pid = model:GetAttribute("ProductId")
			local same = pid == id
			local empty = pid == nil or pid == "" or stock == 0
			if stock < cap and stock <= (H.RestockBelow or 1) and (same or (empty and (pid == nil or pid == "") and holding < limit)) then
				local promptPart = p.Parent
				local partPos = (promptPart and promptPart:IsA("BasePart")) and promptPart.Position or model:GetPivot().Position
				local score = (same and 0 or 10000) + (partPos - rootPos).Magnitude
				if not bestScore or score < bestScore then best, bestScore = p, score end
			end
		end
	end
	return best
end

-- DataConfig does not always say which shelf type a product goes on; the server tells us when we pick wrong
-- ("Hanging packs belong on the hanging shelf"), so we learn the right type from that message.
local learnedCat, learnedTries = {}, {}
local feedbackAt, feedbackMsg = 0, ""
table.insert(conns, Remotes.RestockFeedback.OnClientEvent:Connect(function(msg)
	feedbackAt, feedbackMsg = os.clock(), tostring(msg)
end))
local CAT_WORDS = {
	{ "candy", "candy" }, { "candies", "candy" }, { "hanging", "hanging" }, { "beverage", "beverages" }, { "drink", "beverages" },
	{ "cooler", "beverages" }, { "fridge", "beverages" }, { "refrigerator", "beverages" }, { "freezer", "freezer" }, { "frozen", "freezer" },
	{ "rice", "rice" }, { "produce", "produce" }, { "fruit", "produce" }, { "vegetable", "produce" },
	{ "regular", "general" }, { "normal", "general" }, { "general", "general" },
}
local function catFromText(text)
	local t, bestAt, bestCat = text:lower(), math.huge, nil
	for _, w in ipairs(CAT_WORDS) do
		local at = t:find(w[1], 1, true)
		if at and at < bestAt then bestAt, bestCat = at, w[2] end
	end
	return bestCat
end

local function categoryOf(box)
	local id = box:GetAttribute("ProductId")
	if learnedCat[id] then return learnedCat[id] end
	local def = DataConfig.getProduct(id)
	return (def and def.category) or box:GetAttribute("ShelfCategory") or "general"
end

-- is there anything worth doing right now? (used to decide whether to close the store at all)
local function canRestock()
	local plot = myPlot()
	local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	if not (plot and root) then return false end
	local now = os.clock()
	for _, box in ipairs(boxTools()) do
		if (boxFail[box] or 0) < now and licenseAllowed(box:GetAttribute("ProductId")) and chooseShelf(plot, root.Position, box:GetAttribute("ProductId"), categoryOf(box)) then return true end
	end
	return false
end

local function restockBox(box)
	local ch = lp.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	local plot = myPlot()
	if not (hum and root and plot) then return false end
	local id = box:GetAttribute("ProductId")
	local wantCat = categoryOf(box)
	if not chooseShelf(plot, root.Position, id, wantCat) then return false end -- nothing needs this product: leave the box alone
	if box.Parent ~= ch then
		hum:EquipTool(box)
		local te = os.clock()
		while box.Parent ~= ch and os.clock() - te < 0.3 do task.wait() end
	end
	local placed = false

	for _ = 1, 8 do -- a box rarely needs more than a few shelves
		if not (alive and H.AutoRestock) or (box:GetAttribute("Count") or 0) <= 0 or box.Parent ~= lp.Character then break end
		local best = chooseShelf(plot, root.Position, id, wantCat)
		if not best then break end

		local model = shelfModelOf(best)
		if not model then break end
		local before = model:GetAttribute("Stock") or 0

		-- try firing without walking first (MaxActivationDistance is 40 so often works from anywhere)
		local function fireShelf()
			if model:GetAttribute("Category") == "hanging" then
				Remotes.ShelfActivate:FireServer(model, "restock")
			else
				local was = best.Enabled
				best.Enabled = true
				fireproximityprompt(best)
				best.Enabled = was
			end
		end
		local t0 = os.clock()
		fireShelf()
		while os.clock() - t0 < 0.5 and (model:GetAttribute("Stock") or 0) <= before and feedbackAt < t0 do task.wait() end

		if (model:GetAttribute("Stock") or 0) <= before and feedbackAt >= t0 then
			local learned = (not feedbackMsg:lower():find("^only")) and catFromText(feedbackMsg) or nil
			if learned and learned ~= wantCat and not learnedTries[id .. learned] then
				learnedTries[id .. wantCat] = true
				learnedCat[id] = learned
				wantCat = learned
				placed = true
			else
				skip[model] = true
				task.delay(10, function() skip[model] = nil end)
			end
		else
			-- if it didn't take, walk close and retry once
			if (model:GetAttribute("Stock") or 0) <= before and H.RestockMove then
				local promptPart = best.Parent
				local pos = (promptPart and promptPart:IsA("BasePart")) and promptPart.Position or model:GetPivot().Position
				goNear(pos)
				task.wait()
				before = model:GetAttribute("Stock") or 0
				fireShelf()
				local t1 = os.clock()
				while os.clock() - t1 < 0.6 and (model:GetAttribute("Stock") or 0) <= before do task.wait() end
			end

			stats.actions = stats.actions + 1
			onStats()
			if (model:GetAttribute("Stock") or 0) <= before then
				skip[model] = true
				task.delay(10, function() skip[model] = nil end)
			else
				placed = true
			end
		end
	end
	if not placed then
		hum:UnequipTools()
	end
	return placed
end

-- tries every box you carry, but only those a shelf actually needs right now
local function restockOnce()
	local now = os.clock()
	for _, box in ipairs(boxTools()) do
		if (boxFail[box] or 0) < now and licenseAllowed(box:GetAttribute("ProductId")) then
			if restockBox(box) then return true end
			boxFail[box] = os.clock() + 15  -- shorter blacklist: retry sooner
		end
	end
	return false
end


-- The store only gets closed when a customer is actually waiting for something you cannot give: an unfilled line of the current
-- order whose product is on no shelf. While people are simply buying, restocking happens with the store left open.
local function orderBlocked()
	if not order or os.clock() - orderAt > 25 then return false end
	local plot = myPlot()
	if not plot then return false end
	local models = shelfData(plot).models
	for _, line in ipairs(order) do
		if (tonumber(line.given) or 0) < (tonumber(line.qty) or 0) then
			local have = false
			for _, m in ipairs(models) do
				if m.Parent and m:GetAttribute("ProductId") == line.id and (m:GetAttribute("Stock") or 0) > 0 then have = true break end
			end
			if not have then return true end
		end
	end
	return false
end

-- Store open/close around a restock run: close before the first pickup/shelf, reopen once everything is done.
-- H.RestockHold tells Auto Open Store to leave the store alone while we have it closed on purpose.
local function storeIsOpen()
	local plot = myPlot()
	return plot ~= nil and plot:GetAttribute("StoreOpen") ~= false
end
local function setStore(open)
	if storeIsOpen() ~= open then
		Remotes.ToggleStoreOpen:FireServer()
		for _ = 1, 10 do
			task.wait(0.2)
			if storeIsOpen() == open then break end
		end
	end
end
local function deliveryWaiting()
	local plot = myPlot()
	local bay = plot and plot:FindFirstChild("TruckBay")
	if not bay then return false end
	for _, d in ipairs(bay:GetChildren()) do
		if d.Name == "DeliveryBox" and (d:GetAttribute("Count") or 0) > 0 and licenseAllowed(d:GetAttribute("ProductId")) and d:FindFirstChild("PickupPrompt", true) then return true end
	end
	return false
end

-- Pabilee parcels: when an online order arrives, a "PabileeRiderNPC" (OwnerUserId = you, Received ~= true) waits outside with a
-- PabileeRiderPrompt ("Receive parcel"). Walk out to the rider and use it.
local parcelRetryAt = 0
local function receiveParcel()
	if os.clock() < parcelRetryAt then return false end
	local rider
	for _, v in ipairs(workspace:GetChildren()) do
		if v.Name == "PabileeRiderNPC" and v:GetAttribute("OwnerUserId") == lp.UserId and v:GetAttribute("Received") ~= true then rider = v break end
	end
	local prompt = rider and rider:FindFirstChild("PabileeRiderPrompt", true)
	if not (prompt and prompt.Parent and prompt.Parent:IsA("BasePart")) then return false end
		walkNear(prompt.Parent.Position, 4)
		task.wait()
	local was = prompt.Enabled
	prompt.Enabled = true
	fireproximityprompt(prompt)
	prompt.Enabled = was
	stats.actions = stats.actions + 1
		onStats()
		task.wait(0.3)
		if rider.Parent and rider:GetAttribute("Received") ~= true then parcelRetryAt = os.clock() + 4 end -- did not take: do not spam
	return true
end

-- Instant pickup: its own loop. Every delivery box with a PickupPrompt is triggered the moment it exists (the prompt reaches 40 studs),
-- no walking, no carry cap, so the dropoff zone empties right away and the next queued order can go out.
local pickAt = setmetatable({}, { __mode = "k" })
task.spawn(function()
	while alive do
		task.wait()
		if H.AutoPickupBoxes then
			local plot = myPlot()
			local bay = plot and plot:FindFirstChild("TruckBay")
			if bay then
				local now = os.clock()
				for _, d in ipairs(bay:GetChildren()) do
					if d.Name == "DeliveryBox" and (d:GetAttribute("Count") or 0) > 0 and licenseAllowed(d:GetAttribute("ProductId")) and now - (pickAt[d] or 0) > 0.12 then
						local prompt = d:FindFirstChild("PickupPrompt", true)
						if prompt then
							pickAt[d] = now
							local was = prompt.Enabled
							prompt.Enabled = true
							fireproximityprompt(prompt)
							prompt.Enabled = was
							stats.actions = stats.actions + 1
						end
					end
				end
			end
		end
	end
end)

local function takeShelfBox()
	if not H.AutoTakeShelfBox then return false end
	local plot = myPlot()
	local ch = lp.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not (plot and root and hum) then return false end
	local best, bestD
	for _, slot in ipairs(scanPrompts(plot).slots) do
		if slot.Parent and slot:GetAttribute("Occupied") == true and slot:GetAttribute("IsEmptyBox") ~= true then
			local id = slot:GetAttribute("ProductId")
			if id and id ~= "" and licenseAllowed(id) and (slot:GetAttribute("Count") or 0) > 0 then
				local def = DataConfig.getProduct(id)
				local cat = learnedCat[id] or (def and def.category) or slot:GetAttribute("ShelfCategory") or "general"
				if chooseShelf(plot, root.Position, id, cat) then
					local d = (slot.Position - root.Position).Magnitude
					if not bestD or d < bestD then best, bestD = slot, d end
				end
			end
		end
	end
	local prompt = best and best:FindFirstChild("BoxPrompt")
	if not prompt then return false end
	hum:UnequipTools()
	task.wait()
	local function fire()
		local was = prompt.Enabled
		prompt.Enabled = true
		fireproximityprompt(prompt)
		prompt.Enabled = was
	end
	local function waitTaken(sec)
		local t0 = os.clock()
		while best:GetAttribute("Occupied") == true and os.clock() - t0 < sec do task.wait() end
	end
	fire()
	waitTaken(0.25)
	if best:GetAttribute("Occupied") == true then
		goNear(best.Position)
		fire()
		waitTaken(0.4)
	end
	stats.actions = stats.actions + 1
	onStats()
	return best:GetAttribute("Occupied") ~= true
end

task.spawn(function()
	local retryAt = 0
	while alive do
			task.wait()
			local worked = false
			if H.AutoParcel then
			local okp, rp = pcall(receiveParcel)
			worked = okp and rp
		end
		if worked then
			-- handled the rider this round
		elseif H.AutoRestock and not H.Cleaning and os.clock() >= retryAt then
			local hasWork = canRestock() or (H.AutoPickupBoxes and deliveryWaiting()) or (H.AutoTrashEmpty and #emptyBoxes() > 0 and os.clock() >= trashRetryAt)
			if hasWork and H.CloseWhileRestock and not H.RestockHold and storeIsOpen() and orderBlocked() then
				H.RestockHold = true
				setStore(false)
			end
			if H.AutoTrashEmpty and #emptyBoxes() > 0 then
				local okt, rt = pcall(trashEmpties)
				if not okt then H.LastErr = tostring(rt) end
			end
			local ok, did = pcall(restockOnce)
			if not ok then H.LastErr = tostring(did) end
			worked = ok and did
			if not worked then
				local picked = false
				if H.AutoPickupBoxes then -- keep collecting deliveries even while you carry boxes nothing needs yet
					local ok2, r = pcall(pickupBox)
						if not ok2 then H.LastErr = tostring(r) end
					picked = ok2 and r
				end
					if not picked then
						local okt2, rt2 = pcall(takeShelfBox)
						if not okt2 then H.LastErr = tostring(rt2) end
						picked = okt2 and rt2
					end
					local trashed = false
					if not picked and H.AutoTrashEmpty then
					local ok3, r3 = pcall(trashEmpties)
						if not ok3 then H.LastErr = tostring(r3) end
					trashed = ok3 and r3
				end
				worked = picked or trashed
				if not worked then
					endTrip()
					if H.RestockHold then
						H.RestockHold = false
						setStore(true)
					end
					if #boxTools() > 0 and not canRestock() then retryAt = os.clock() + 10 end
						task.wait(0.3)
				end
			end
		elseif not H.AutoRestock then
			if tripHome then endTrip() end
			if H.RestockHold then
				H.RestockHold = false
				setStore(true)
			end
		end
	end
end)

-- Auto palo (slipper) at thieves: a shoplifting customer is an NPC model in workspace with SariShoplifter == true. The Tsinelas
-- (a Tool with SariWeapon == true) hits through HitNPC:FireServer(npcModel). Equip it, get next to the thief, smack until it
-- is gone, then go back to where you were.
-- A thief is either a customer flagged SariShoplifter (already ran off with items) or one caught mid-steal: some attribute
-- named like steal/thief/shoplift set to true, or the red "STEALING!" bar floating over its head.
local function isThief(m)
	if m:GetAttribute("HitImmune") == true then return false end
	for k, v in pairs(m:GetAttributes()) do
		local lk = k:lower()
		if v == true and (lk:find("steal", 1, true) or lk:find("thie", 1, true) or lk:find("shoplift", 1, true)) then return true end
	end
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("TextLabel") and d.Visible and d.Text:upper():find("STEAL", 1, true) then
			local g = d:FindFirstAncestorWhichIsA("BillboardGui")
			if g and g.Enabled then return true end
		end
	end
	return false
end

-- returns the bounding box (min, max Vector3) of my plot's floor area
local function plotBounds()
	local plot = myPlot()
	if not plot then return nil end
	local mn, mx = Vector3.new(math.huge,math.huge,math.huge), Vector3.new(-math.huge,-math.huge,-math.huge)
