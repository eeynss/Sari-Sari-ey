				txt.TextColor3 = C.muted
				if i.KeyCode ~= Enum.KeyCode.Escape then obj:Set(i.KeyCode) else show() end
			end
		end)
	end)
	return obj
end

-- multi-select dropdown: the popup stays open while you tick several options; it has a search box.
-- o.Options = list of strings, o.Selected = set { [option] = true }, o.Callback(set). obj:Get() -> set, obj:Set(set, silent).
function Section:AddMultiDropdown(o)
	local row, wrap = self:_row(o.Name, 30, 90)
