local function textWidth(text, size)
	return TextService:GetTextSize(text, size or 12, Enum.Font.Gotham, Vector2.new(4000, 100)).X
end

-- avail = pixels the name has next to its control; on mobile a name that does not fit gets a second line (taller row)
function Section:_row(name, h, avail)
	self.Count = self.Count + 1
	local wrap = false
	if avail and self.Tab.Ui.IsMobile and textWidth(name, 12) > avail then
		h = (h or 28) + 14
		wrap = true
	end
	local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, h or 28), LayoutOrder = self.Count }, self.Card)
	table.insert(self.Tab.Rows, { Frame = row, Name = name })
	return row, wrap
end

local function wrapName(lbl, wrap)
	if wrap then
		lbl.TextWrapped = true
		lbl.TextTruncate = Enum.TextTruncate.None
	end
end

function Section:AddLabel(text, height)
	if not height and self.Tab.Ui.IsMobile then
		local y = TextService:GetTextSize(text, 11, Enum.Font.Gotham, Vector2.new(222, 4000)).Y
		if y > 16 then height = math.ceil(y) + 6 end
	end
	local row = self:_row(text, height or 20)
	local l = label(row, text, 11, C.muted, false)
	l.Size = UDim2.fromScale(1, 1)
	l.TextWrapped = true
	if height then
		l.TextTruncate = Enum.TextTruncate.None
		l.TextYAlignment = Enum.TextYAlignment.Top
	end
	return { Set = function(_, t) l.Text = t end }
end

function Section:AddToggle(o)
	local row, wrap = self:_row(o.Name, nil, 166)
	local ui = self.Tab.Ui
	local name = label(row, o.Name, 12, C.text, false)
	name.Size = UDim2.new(1, -52, 1, 0)
	wrapName(name, wrap)
	local sw = new("TextButton", { Size = UDim2.fromOffset(40, 21), Position = UDim2.new(1, -40, 0.5, -10), Text = "", AutoButtonColor = false, BackgroundColor3 = C.card, BackgroundTransparency = 0.8 }, row)
	round(sw, 11)
	local st = new("UIStroke", { Color = Color3.new(1, 1, 1), Transparency = 0.75, Thickness = 1 }, sw)
	local knob = new("Frame", { Size = UDim2.fromOffset(15, 15), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = C.muted, BorderSizePixel = 0 }, sw)
	round(knob, 8)
	local state
	local function render(animate)
		local t = animate and 0.25 or 0
		tween(knob, t, { Position = UDim2.fromOffset(state and 22 or 3, 3), BackgroundColor3 = state and Color3.new(1, 1, 1) or C.muted }, Enum.EasingStyle.Back)
		tween(sw, t, { BackgroundColor3 = state and C.pink or C.card, BackgroundTransparency = state and 0.1 or 0.8 })
		tween(st, t, { Transparency = state and 0.2 or 0.75 })
	end
	local obj = {}
	function obj:Set(v, silent)
		state = v and true or false
		if o.Flag then ui.Flags[o.Flag] = state end
		render(true)
		if not silent and o.Callback then task.spawn(o.Callback, state) end
	end
	state = o.Default and true or false
	if o.Flag then ui.Flags[o.Flag] = state ui.Elements[o.Flag] = obj end
	render(false)
	sw.MouseButton1Click:Connect(function() obj:Set(not state) end)
	row.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseMovement then tween(name, 0.15, { TextColor3 = C.pink }) end end)
	row.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseMovement then tween(name, 0.15, { TextColor3 = C.text }) end end)
	return obj
end

function Section:AddButton(o)
