-- keys). Buys the cheapest locked one in order, only when you keep at least H.LicenseReserve pesos afterwards. Money = the
-- PlayerListMoney attribute on you.
local ownedLicenses = {}
table.insert(conns, Remotes.LicenseUpdate.OnClientEvent:Connect(function(owned)
	if type(owned) == "table" then ownedLicenses = owned end
end))

-- The game only tells us the owned licenses when one changes, so work it out from what the Stock Notice and your inventory show:
-- those only list products you are allowed to sell, and licenses unlock in order, so the highest license among them (and every one
-- below it) is yours.
local function syncOwnedLicenses()
	local maxN = 1
	local function consider(id)
		local n = tonumber(tostring(licenseOf(id)):match("%d+"))
		if n and n > maxN then maxN = n end
	end
	pcall(function()
		local rep = Remotes.GetStockReport:InvokeServer()
		for _, group in ipairs({ rep.outOfStock or {}, rep.lowStock or {} }) do
			for _, it in ipairs(group) do consider(it.id) end
		end
	end)
	pcall(function()
		for id in pairs(Remotes.GetInventoryCounts:InvokeServer()) do consider(id) end
	end)
	for n = 1, maxN do ownedLicenses["L" .. n] = true end
	return maxN
end
