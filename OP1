local function buttonWords(btn)
	local name = tostring(btn.Name or ""):lower()
	local label = ""
	pcall(function()
		if btn:IsA("TextButton") then label = tostring(btn.Text or ""):lower() end
	end)
	return name .. " " .. label
end

local function pressGuiButton(btn)
	if not guiActuallyVisible(btn) then return false end
	local fired = false

	-- Best path for executors that expose firesignal.
	if type(firesignal) == "function" then
		for _, signalName in ipairs({ "Activated", "MouseButton1Click", "MouseButton1Up" }) do
			pcall(function()
				firesignal(btn[signalName])
				fired = true
			end)
		end
	end

	-- Fallback: tap/click the visual center of the button.
	if not fired then
		pcall(function()
			local p = btn.AbsolutePosition
			local s = btn.AbsoluteSize
			local x = p.X + s.X * 0.5
			local y = p.Y + s.Y * 0.5
			VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
			task.wait(0.05)
			VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
			fired = true
		end)
	end

	return fired
end

local function startupButtonKind(btn)
	if not btn:IsA("GuiButton") or not guiActuallyVisible(btn) then return nil end
	local words = buttonWords(btn)

	-- Skip takes priority over Play/Start.
	if words:find("skip", 1, true) then return "skip" end

	-- Use conservative startup words so random in-game buttons are not pressed.
	for _, word in ipairs({ "play", "start", "begin", "enter" }) do
		if words:find(word, 1, true) then return "play" end
	end

	return nil
end

