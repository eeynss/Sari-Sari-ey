-- Auto clean: take the right broom (Broom indoors, Broomstick for outdoor leaf piles), stand next to the pile and hold its prompt.
-- It has to be within ~4.5 studs of the pile, so it only runs when "Let Script Walk My Character" is on.
local function toolNamed(name)
	for _, holder in ipairs({ lp.Character, lp.Backpack }) do
		if holder then
			for _, t in ipairs(holder:GetChildren()) do
				if t:IsA("Tool") and t.Name == name then return t end
			end
		end
	end
end

local function cleanOnce()
	local plot, ch = myPlot(), lp.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not (plot and root and hum) then return false end
	local best, bd
	for _, d in ipairs(plot:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Name == "CleanPilePrompt" and d.Parent and d.Parent:IsA("BasePart") then
			local m = d:FindFirstAncestorWhichIsA("Model")
			if m and shelfVisible(m) then
				local dist = (d.Parent.Position - root.Position).Magnitude
				if not bd or dist < bd then best, bd = d, dist end
			end
		end
	end
	if not best then return false end
	local want = best:GetAttribute("CleanArea") == "outdoor" and "Broomstick" or "Broom"
	local tool = toolNamed(want)
	if not tool then
		for _, d in ipairs(plot:GetDescendants()) do
			if d:IsA("ProximityPrompt") and d.Name == "CleaningPrompt" and d.ObjectText == want and shelfVisible(d) then
				local was = d.Enabled
				d.Enabled = true
				fireproximityprompt(d)
				d.Enabled = was
				break
			end
		end
		local t0 = os.clock()
		while not toolNamed(want) and os.clock() - t0 < 1 do task.wait() end
		tool = toolNamed(want)
		if not tool then return false end
	end
	if tool.Parent ~= ch then
		hum:EquipTool(tool)
		local te = os.clock()
		while tool.Parent ~= ch and os.clock() - te < 0.4 do task.wait() end
	end
	walkNear(best.Parent.Position, 3)
	if (best.Parent.Position - root.Position).Magnitude > 4.5 then return false end
	best.Enabled = true
	best:InputHoldBegin()
	task.wait((best.HoldDuration > 0 and best.HoldDuration or 3) + 0.15)
	best:InputHoldEnd()
	stats.actions = stats.actions + 1
	onStats()
	return true
end

