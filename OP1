-- Orders: PurchaseOrder takes a list of { id = productId, qty = boxes }; PurchaseResult(ok, message).
-- The dropoff zone only holds so many products at once (50 by default, "room for N more"), so every order goes through a queue:
-- we send what fits, learn the real room from the server's answer, and send the rest once the boxes have been picked up.
H.LastPurchase = "-"
H.DropoffRoom = 50
local orderQueue, lastBatch = {}, nil
local lastSend, lastReject = 0, 0

H.SoldOutUntil = {} -- product id -> os.clock() when the shop restocks it
function H.IsSoldOut(id)
	local t = H.SoldOutUntil[id]
	if t and os.clock() < t then return true end
	if t then H.SoldOutUntil[id] = nil end
	return false
end
function H.SoldOutCount()
	local n = 0
	for id in pairs(H.SoldOutUntil) do
		if H.IsSoldOut(id) then n = n + 1 end
	end
	return n
end

function H.QueueList()
	local rows = {}
	for _, l in ipairs(orderQueue) do
		local d = DataConfig.getProduct(l.id)
		rows[#rows + 1] = ((d and d.name) or tostring(l.id)) .. " x" .. tostring(l.qty)
	end
	return rows
end
function H.SoldOutNames()
	local rows = {}
	for id in pairs(H.SoldOutUntil) do
		if H.IsSoldOut(id) then
			local d = DataConfig.getProduct(id)
			rows[#rows + 1] = (d and d.name) or tostring(id)
		end
	end
	table.sort(rows)
	return rows
end

function H.QueueSize()
	local n = 0
	for _, l in ipairs(orderQueue) do n = n + (tonumber(l.qty) or 0) end
	return n
end

local function queueOrder(lines)
	for _, l in ipairs(lines) do
		if not H.IsSoldOut(l.id) then table.insert(orderQueue, { id = l.id, qty = l.qty }) end
	end
end

local function flushOrders()
	if #orderQueue == 0 then return false end
	if lastBatch and os.clock() - lastSend < 10 then return false end -- one batch at a time: wait for the server's reply
	local room = math.floor(tonumber(H.DropoffRoom) or 50)
	if room <= 0 then return false end
	local batch, used = {}, 0
	while #orderQueue > 0 and used < room do
		local l = orderQueue[1]
		local fit = math.min(l.qty, room - used)
		table.insert(batch, { id = l.id, qty = fit })
		used = used + fit
		if fit >= l.qty then table.remove(orderQueue, 1) else l.qty = l.qty - fit end
	end
	lastBatch = batch
	lastSend = os.clock()
	Remotes.PurchaseOrder:FireServer(batch)
	stats.actions = stats.actions + 1
	onStats()
	return true
end

table.insert(conns, Remotes.PurchaseResult.OnClientEvent:Connect(function(ok, msg)
	local text = type(msg) == "string" and msg or ""
	local left = #orderQueue
	if ok then
		lastBatch = nil
		H.LastPurchase = "Order placed" .. (left > 0 and (" (" .. left .. " more item lines queued)") or "")
	else
		local room = tonumber(text:match("room for (%d+)"))
		local busy = text:lower():find("on its way", 1, true) or text:lower():find("wait for the truck", 1, true)
		if busy and lastBatch then
			for i = #lastBatch, 1, -1 do table.insert(orderQueue, 1, lastBatch[i]) end
			lastSend = os.clock() + 6
			H.LastPurchase = "A delivery is on its way; the rest is queued and will be ordered after the truck arrives"
		elseif lastBatch and text:match("^(.-) is sold out") then
			-- one sold-out item makes the server refuse the whole order: drop that item and send the rest again
			local name = text:match("^(.-) is sold out")
			local soldId
			for _, def in ipairs(DataConfig.PRODUCTS or {}) do
				if def.name == name then soldId = def.id break end
			end
			if soldId then
				local m, sec = text:match("New stock in (%d+):(%d+)")
				local wait = m and (tonumber(m) * 60 + tonumber(sec)) or 180
				H.SoldOutUntil[soldId] = os.clock() + wait + 2
			end
			local rest = {}
			for _, l in ipairs(lastBatch) do
				if l.id ~= soldId then table.insert(rest, l) end
			end
			for i = #orderQueue, 1, -1 do
				if orderQueue[i].id == soldId then table.remove(orderQueue, i) end
			end
			for i = #rest, 1, -1 do table.insert(orderQueue, 1, rest[i]) end
			lastSend = os.clock() - 3.5
			H.LastPurchase = name .. " is sold out: unlisted until it restocks; sending the rest"
		elseif room and lastBatch then
			H.DropoffRoom = room
			lastReject = os.clock()
			for i = #lastBatch, 1, -1 do table.insert(orderQueue, 1, lastBatch[i]) end
			H.LastPurchase = "Dropoff zone is full (room for " .. room .. "); the rest is queued and will be ordered once boxes are picked up"
		else
			orderQueue = {}
			H.LastPurchase = "Order failed" .. (text ~= "" and (": " .. text) or "")
		end
		lastBatch = nil
	end
	if H.OnPurchase then H.OnPurchase(H.LastPurchase) end
end))

task.spawn(function()
	while alive do
		task.wait(1)
		if #orderQueue > 0 and not lastBatch and os.clock() - lastSend > 4 then
			if H.DropoffRoom <= 0 and os.clock() - lastReject > 5 then H.DropoffRoom = 50 end
			flushOrders()
		end
	end
end)

-- Buy one box of every item you are allowed to sell. Unlocked = its license (DataConfig.PRODUCT_LICENSE) is L1 or owned.
-- Cost of a box = buy price x boxSize. Cheapest first, only as many as fit in (your cash - reserve). onlyLow = skip items you
-- already hold at least a box of. The delivery then lands in the truck bay and the pickup/restock loops do the rest.
local function buyOneOfEach(onlyLow)
	if #orderQueue > 0 or lastBatch then
		H.LastPurchase = "Already ordering (" .. H.QueueSize() .. " box(es) still queued): wait until it finishes"
		if H.OnPurchase then H.OnPurchase(H.LastPurchase) end
		return 0, 0, 0
	end
	syncOwnedLicenses()
	local money = tonumber(lp:GetAttribute("PlayerListMoney")) or 0
	local budget = money - (H.LicenseReserve or 0)
	local counts = {}
	if onlyLow then
		local ok, c = pcall(function() return Remotes.GetInventoryCounts:InvokeServer() end)
		if ok and type(c) == "table" then counts = c end
	end
	local list = {}
	for _, def in ipairs(DataConfig.PRODUCTS or {}) do
		local lic = (DataConfig.PRODUCT_LICENSE and DataConfig.PRODUCT_LICENSE[def.id]) or (DataConfig.RICE_PRODUCT_LICENSE and DataConfig.RICE_PRODUCT_LICENSE[def.id]) or "L1"
		local unlocked = lic == "L1" or ownedLicenses[lic]
		local box = def.boxSize or 1
		if def.id and def.buy and unlocked and not H.IsSoldOut(def.id) and (not onlyLow or (counts[def.id] or 0) < box) then
			table.insert(list, { id = def.id, cost = def.buy * box })
		end
	end
	table.sort(list, function(a, b) return a.cost < b.cost end)
	local order, spent = {}, 0
	for _, it in ipairs(list) do
		if spent + it.cost <= budget then
			table.insert(order, { id = it.id, qty = 1 })
			spent = spent + it.cost
		end
	end
	if #order == 0 then return 0, #list, 0 end
	queueOrder(order)
	flushOrders()
	return #order, #list, spent
end
H.BuyOneOfEach = buyOneOfEach

-- what ordering one box of EVERY unlocked item would cost (ignores your cash), for the label in the Shop tab
function H.QuoteEach()
	syncOwnedLicenses()
	local total, n = 0, 0
	for _, def in ipairs(DataConfig.PRODUCTS or {}) do
		local lic = (DataConfig.PRODUCT_LICENSE and DataConfig.PRODUCT_LICENSE[def.id]) or (DataConfig.RICE_PRODUCT_LICENSE and DataConfig.RICE_PRODUCT_LICENSE[def.id]) or "L1"
		if def.id and def.buy and (lic == "L1" or ownedLicenses[lic]) then
			total = total + def.buy * (def.boxSize or 1)
			n = n + 1
		end
	end
	return total, n
end

