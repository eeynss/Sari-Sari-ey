local remodelHiddenCache = setmetatable({}, { __mode = "k" })
local function remodelHidden(model, plot)
	if not plot or plot:GetAttribute("RemodelSwapped") ~= true then return false end
	local top = model
	while top.Parent and top.Parent ~= plot and top.Parent.Parent ~= plot do top = top.Parent end
	local c = remodelHiddenCache[top]
	if c and os.clock() - c.t < 2 then return c.v end
	local v = false
	for _, d in ipairs(top:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("RemodelHidden") == true then v = true break end
	end
	remodelHiddenCache[top] = { t = os.clock(), v = v }
	return v
