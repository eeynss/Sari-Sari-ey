-- Eynch Hub | Sari-Sari Store automation | single file, plain Lua 5.1 syntax
do
	if not game:IsLoaded() then game.Loaded:Wait() end
	local P = game:GetService("Players")
	while not P.LocalPlayer do task.wait() end
	local me = P.LocalPlayer
	if not me.Character then me.CharacterAdded:Wait() end
	if not me:FindFirstChildOfClass("PlayerGui") then me:WaitForChild("PlayerGui") end
	if not workspace:FindFirstChild("Plots") then workspace:WaitForChild("Plots") end
	game:GetService("ReplicatedStorage"):WaitForChild("SariSariStore")
