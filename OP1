local GlassUI = (function()
-- GlassUI: glassmorphism hub UI (frosted translucent window (no screen blur), gradient rim, logo, glyph tabs, search, animated everything,
-- smooth drag with a "skeleton" ghost). Same API shape as PlumUI:
--   local ui  = GlassUI.new({ Title = "My Hub", Version = "v1.0", ToggleKey = Enum.KeyCode.RightShift })
--   local tab = ui:AddTab("Store", "🏪")
--   local sec = tab:AddSection("Orders", "left", "🧾")      -- "left" | "right" | "full"
--   sec:AddToggle({ Name, Default, Flag, Callback }) / AddSlider({ Name, Min, Max, Default, Decimals, Callback })
--   sec:AddButton({ Name, Callback }) / sec:AddLabel(text) -> { Set = function(_, text) end }
--   ui.Flags[flag], ui:SetVisible(bool), ui:Destroy()

local GlassUI = {}
GlassUI.__index = GlassUI

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TS = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local TextService = game:GetService("TextService")
local lp = Players.LocalPlayer

local C = {
	tint = Color3.fromRGB(34, 18, 34),
	card = Color3.fromRGB(255, 235, 248),
	text = Color3.fromRGB(250, 240, 247),
	muted = Color3.fromRGB(190, 160, 182),
	pink = Color3.fromRGB(255, 140, 185),
	pink2 = Color3.fromRGB(190, 120, 255),
	green = Color3.fromRGB(125, 225, 160),
}
GlassUI.Colors = C

local function new(class, props, parent)
	local i = Instance.new(class)
	for k, v in pairs(props or {}) do i[k] = v end
	i.Parent = parent
	return i
end
local function round(i, r) return new("UICorner", { CornerRadius = UDim.new(0, r) }, i) end
local function tween(i, t, props, style, dir)
	local tw = TS:Create(i, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end
local function pad(i, l, t, r, b)
	return new("UIPadding", { PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t or l), PaddingRight = UDim.new(0, r or l), PaddingBottom = UDim.new(0, b or t or l) }, i)
end
local function label(parent, text, size, color, bold)
	return new("TextLabel", {
		BackgroundTransparency = 1, Text = text, TextSize = size, TextColor3 = color or C.text, TextXAlignment = Enum.TextXAlignment.Left,
		Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham, TextTruncate = Enum.TextTruncate.AtEnd,
	}, parent)
end

-- frosted pane: translucent tint + diagonal sheen + gradient light rim
local function glass(i, radius, transp, rimTransp)
	i.BackgroundColor3 = C.tint
	i.BackgroundTransparency = transp
	i.BorderSizePixel = 0
	round(i, radius)
	local sheen = new("UIGradient", { Rotation = 35, Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.55, 0.12), NumberSequenceKeypoint.new(1, 0.3),
	}) }, i)
	local s = new("UIStroke", { Thickness = 1, Color = Color3.new(1, 1, 1), Transparency = rimTransp or 0.7, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, i)
	new("UIGradient", { Rotation = 55, Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.75), NumberSequenceKeypoint.new(1, 0.15),
	}) }, s)
	return s, sheen
end

-- the Eynch mark: a rotating gradient orbit around a gradient badge with a hand-built "E"
local function logo(parent, size, pos)
	local holder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size), Position = pos }, parent)
	local orbit = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, holder)
	round(orbit, size)
	local st = new("UIStroke", { Thickness = math.max(1.5, size / 16), Color = Color3.new(1, 1, 1) }, orbit)
	local g = new("UIGradient", { Color = ColorSequence.new(C.pink, C.pink2), Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.55, 0.15), NumberSequenceKeypoint.new(0.62, 0.9), NumberSequenceKeypoint.new(1, 0.9),
	}) }, st)
	local badge = new("Frame", { Size = UDim2.fromScale(0.68, 0.68), Position = UDim2.fromScale(0.16, 0.16), BackgroundColor3 = C.pink, BorderSizePixel = 0 }, holder)
	round(badge, size * 0.2)
	new("UIGradient", { Color = ColorSequence.new(C.pink, C.pink2), Rotation = 45 }, badge)
	local function bar(x, y, w, h)
		local f = new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Position = UDim2.fromScale(x, y), Size = UDim2.fromScale(w, h) }, badge)
		round(f, 2)
	end
	bar(0.27, 0.2, 0.16, 0.6) -- spine
	bar(0.27, 0.2, 0.5, 0.15) -- top
	bar(0.27, 0.425, 0.4, 0.15) -- middle
	bar(0.27, 0.65, 0.5, 0.15) -- bottom
	return holder, g
end

-- fullscreen loading splash with the Eynch logo; blocks until it has faded out
local function splash(gui, subtitle)
	local root = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(10, 5, 12), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 500 }, gui)
	tween(root, 0.4, { BackgroundTransparency = 0.25 })
	local card = new("CanvasGroup", { Size = UDim2.fromOffset(340, 250), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), GroupTransparency = 1, ZIndex = 501 }, root)
	glass(card, 22, 0.3, 0.5)
	local sc = new("UIScale", { Scale = 0.85 }, card)
	tween(card, 0.5, { GroupTransparency = 0 })
	tween(sc, 0.6, { Scale = 1 }, Enum.EasingStyle.Back)

	local lg, grad = logo(card, 84, UDim2.new(0.5, -42, 0, 26))
	local spin = RunService.RenderStepped:Connect(function(dt) grad.Rotation = (grad.Rotation + dt * 240) % 360 end)

	local letters = { "E", "Y", "N", "C", "H" }
	local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(200, 30), Position = UDim2.new(0.5, -100, 0, 124) }, card)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 8) }, row)
	for i, ch in ipairs(letters) do
		local l = new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(24, 30), Text = ch, TextSize = 26, Font = Enum.Font.GothamBlack, TextColor3 = C.text, TextTransparency = 1, LayoutOrder = i }, row)
		task.delay(0.35 + i * 0.09, function()
			tween(l, 0.4, { TextTransparency = 0 })
			if i == 1 or i == 3 or i == 5 then tween(l, 0.4, { TextColor3 = C.pink }) end
		end)
	end
	local sub = label(card, subtitle or "", 11, C.muted, false)
	sub.Size, sub.Position, sub.TextXAlignment = UDim2.new(1, 0, 0, 14), UDim2.fromOffset(0, 158), Enum.TextXAlignment.Center

	local track = new("Frame", { Size = UDim2.fromOffset(220, 5), Position = UDim2.new(0.5, -110, 0, 188), BackgroundColor3 = C.card, BackgroundTransparency = 0.8, BorderSizePixel = 0 }, card)
	round(track, 3)
	local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.pink, BorderSizePixel = 0 }, track)
	round(fill, 3)
	new("UIGradient", { Color = ColorSequence.new(C.pink, C.pink2) }, fill)
	local status = label(card, "", 10, C.muted, false)
	status.Size, status.Position, status.TextXAlignment = UDim2.new(1, 0, 0, 14), UDim2.fromOffset(0, 202), Enum.TextXAlignment.Center

	local steps = { { "Starting up", 0.2 }, { "Hooking remotes", 0.45 }, { "Reading your store", 0.7 }, { "Building interface", 0.92 }, { "Ready", 1 } }
	task.wait(0.5)
	for _, st in ipairs(steps) do
		status.Text = st[1] .. "..."
		tween(fill, 0.45, { Size = UDim2.fromScale(st[2], 1) }, Enum.EasingStyle.Quad)
		task.wait(0.5)
	end
	task.wait(0.25)
	tween(card, 0.45, { GroupTransparency = 1 })
	tween(sc, 0.45, { Scale = 1.08 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(root, 0.5, { BackgroundTransparency = 1 })
	task.wait(0.5)
	spin:Disconnect()
	root:Destroy()
end

function GlassUI.new(opts)
	opts = opts or {}
	local self = setmetatable({}, GlassUI)
	self.Flags, self.Tabs, self.ToggleKey, self.Conns = {}, {}, opts.ToggleKey or Enum.KeyCode.RightShift, {}
	self.Elements, self.SkeletonEnabled = {}, true
	local function conn(c) table.insert(self.Conns, c) return c end

	local gui = new("ScreenGui", { Name = "GlassUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 999 })
	gui.Parent = (gethui and gethui()) or game:GetService("CoreGui")
	self.Gui = gui

	if opts.Splash ~= false then splash(gui, opts.Title) end

	if gui.AbsoluteSize.X < 100 then RunService.RenderStepped:Wait() end
	local view = gui.AbsoluteSize
	if view.X < 100 then view = workspace.CurrentCamera.ViewportSize end

	local isMobile = UIS.TouchEnabled or (getgenv and getgenv().EynchForceMobile == true) or false
	self.IsMobile = isMobile
	local sideW = isMobile and 62 or 84
	local gutter = sideW + 18
	local W = isMobile and 340 or math.clamp(math.floor(view.X * 0.42), 760, 980)
	local H = isMobile and 250 or math.clamp(math.floor(view.Y * 0.62), 500, 660)

	-- Same centered presentation as the 340x250 loading card.
	local startPos = Vector2.new(
		math.max(0, math.floor((view.X - W) / 2)),
		math.max(0, math.floor((view.Y - H) / 2))
	)

	local win = new("CanvasGroup", { Name = "Window", Size = UDim2.fromOffset(W, H), Position = UDim2.fromOffset(startPos.X, startPos.Y), GroupTransparency = 1 }, gui)
	glass(win, 18, 0.28, 0.55)
	self.Win = win
	local scale = new("UIScale", { Scale = 0.93 }, win)
	-- Mobile already uses a real 340x250 window, so no extra shrink is needed.
	local mobileFit = 1
	self.MobileFitScale = mobileFit
	self.UserScale = new("UIScale", { Scale = 1 }, win)

	-- ===== sidebar =====
	local side = new("Frame", { Size = UDim2.new(0, sideW, 1, -20), Position = UDim2.fromOffset(10, 10) }, win)
	glass(side, 14, 0.5, 0.75)
	local lg, lgGrad = logo(side, 34, UDim2.new(0.5, -17, 0, 14))
	conn(RunService.RenderStepped:Connect(function(dt) lgGrad.Rotation = (lgGrad.Rotation + dt * 60) % 360 end))

	local tabsHolder
	if isMobile then
		-- Mobile: make the left navigation independently scrollable.
		tabsHolder = new("ScrollingFrame", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 1, -128),
			Position = UDim2.fromOffset(0, 58),
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 2,
			ScrollBarImageColor3 = C.pink,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
			VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
			Active = true,
			ScrollingEnabled = true,
		}, side)
	else
		tabsHolder = new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, -140),
			Position = UDim2.fromOffset(0, 62),
		}, side)
	end
	new("UIListLayout", {
		Padding = UDim.new(0, 6),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder
	}, tabsHolder)
	self.TabsHolder = tabsHolder
	local indicator = new("Frame", { Size = UDim2.fromOffset(3, 24), BackgroundColor3 = C.pink, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 70), Visible = false }, side)
	round(indicator, 2)
	self.Indicator = indicator

	-- footer: avatar + name
	local foot = new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, isMobile and 58 or 66),
		Position = UDim2.new(0, 0, 1, isMobile and -62 or -72)
	}, side)
	new("Frame", { Size = UDim2.new(1, -20, 0, 1), Position = UDim2.fromOffset(10, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.85, BorderSizePixel = 0 }, foot)
	local av = new("ImageLabel", { Size = UDim2.fromOffset(34, 34), Position = UDim2.new(0.5, -17, 0, 8), BackgroundColor3 = C.card, BackgroundTransparency = 0.7 }, foot)
	round(av, 17)
	new("UIStroke", { Color = C.pink, Thickness = 1.5, Transparency = 0.2 }, av)
	task.spawn(pcall, function() av.Image = Players:GetUserThumbnailAsync(lp.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100) end)
	local dot = new("Frame", { Size = UDim2.fromOffset(9, 9), Position = UDim2.new(0.5, 8, 0, 33), BackgroundColor3 = C.green, BorderSizePixel = 0 }, foot)
	round(dot, 5)
	new("UIStroke", { Color = C.tint, Thickness = 1.5 }, dot)
	local nm = label(foot, lp.DisplayName, 10, C.text, true)
	nm.Size, nm.Position, nm.TextXAlignment = UDim2.new(1, -8, 0, 14), UDim2.fromOffset(4, 46), Enum.TextXAlignment.Center

	-- ===== header =====
	local header = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -(gutter + 10), 0, isMobile and 36 or 44), Position = UDim2.fromOffset(gutter, 8) }, win)
	local titleGlyph = label(header, "", 18, C.pink, true)
	titleGlyph.Size, titleGlyph.Position = UDim2.fromOffset(24, 44), UDim2.fromOffset(2, 0)
	local title = label(header, opts.Title or "GlassUI", 16, C.text, true)
	title.Size, title.Position = UDim2.new(1, isMobile and -96 or -250, 1, 0), UDim2.fromOffset(30, 0)
	if isMobile then title.TextSize = 13 end
	self.TitleLabel, self.TitleGlyph = title, titleGlyph

	local search = new("Frame", { Size = UDim2.fromOffset(150, 28), Position = UDim2.new(1, -196, 0.5, -14), Visible = not isMobile }, header)
	glass(search, 9, 0.62, 0.8)
	label(search, "🔍", 12, C.muted, false).Size = UDim2.fromOffset(24, 28)
	search:FindFirstChildOfClass("TextLabel").Position = UDim2.fromOffset(8, 0)
	local box = new("TextBox", {
		BackgroundTransparency = 1, Size = UDim2.new(1, -34, 1, 0), Position = UDim2.fromOffset(28, 0), PlaceholderText = "Search", Text = "",
		PlaceholderColor3 = C.muted, TextColor3 = C.text, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
	}, search)

	local function headBtn(txt, x, hoverColor)
		local b = new("TextButton", { Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, x, 0.5, -14), Text = txt, Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = C.text, AutoButtonColor = false }, header)
		glass(b, 9, 0.62, 0.8)
		b.MouseEnter:Connect(function() tween(b, 0.15, { BackgroundTransparency = 0.35, TextColor3 = hoverColor or C.pink }) end)
		b.MouseLeave:Connect(function() tween(b, 0.15, { BackgroundTransparency = 0.62, TextColor3 = C.text }) end)
		return b
	end
	local minB = headBtn("–", -60)
	local closeB = headBtn("✕", -28, Color3.fromRGB(255, 110, 120))

	-- ===== content area =====
	local content = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -(gutter + 10), 1, isMobile and -52 or -64), Position = UDim2.fromOffset(gutter, isMobile and 46 or 54), ClipsDescendants = true }, win)
	self.Content = content

	-- floating logo button shown while the window is hidden
	local fab = new("TextButton", { Size = UDim2.fromOffset(46, 46), Position = UDim2.new(0, 18, 1, -64), Text = "", AutoButtonColor = false, Visible = false }, gui)
	glass(fab, 23, 0.35, 0.5)
	logo(fab, 24, UDim2.fromOffset(11, 11))

	-- ===== visibility =====
	local visible = false
	function self:SetVisible(v)
		visible = v
		if v then
			win.Visible, fab.Visible = true, false
			tween(win, 0.45, { GroupTransparency = 0 })
			tween(scale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
		else
			tween(win, 0.28, { GroupTransparency = 1 })
			local t = tween(scale, 0.3, { Scale = 0.93 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			t.Completed:Once(function() if not visible then win.Visible = false fab.Visible = true fab.Size = UDim2.fromOffset(0, 0) tween(fab, 0.35, { Size = UDim2.fromOffset(46, 46) }, Enum.EasingStyle.Back) end end)
		end
	end
	minB.MouseButton1Click:Connect(function() self:SetVisible(false) end)
	fab.MouseButton1Click:Connect(function() self:SetVisible(true) end)
	closeB.MouseButton1Click:Connect(function() self:Destroy() end)
	conn(UIS.InputBegan:Connect(function(i, gp)
		if not gp and i.KeyCode == self.ToggleKey then self:SetVisible(not visible) end
	end))

	-- ===== drag with skeleton ghost =====
	local ghost = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(W, H), Visible = false }, gui)
	round(ghost, 18)
	local gs = new("UIStroke", { Color = C.pink, Thickness = 1.5, Transparency = 0.2 }, ghost)
	new("Frame", { BackgroundColor3 = C.pink, BackgroundTransparency = 0.9, Size = UDim2.fromScale(1, 1), BorderSizePixel = 0 }, ghost)
	round(ghost:FindFirstChildOfClass("Frame"), 18)
	for _, c in ipairs({ { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } }) do -- corner brackets
		local h = new("Frame", { Size = UDim2.fromOffset(16, 2), BackgroundColor3 = C.pink, BorderSizePixel = 0, AnchorPoint = Vector2.new(c[1], c[2]), Position = UDim2.new(c[1], c[1] == 0 and 8 or -8, c[2], c[2] == 0 and 8 or -8) }, ghost)
		local v = new("Frame", { Size = UDim2.fromOffset(2, 16), BackgroundColor3 = C.pink, BorderSizePixel = 0, AnchorPoint = Vector2.new(c[1], c[2]), Position = UDim2.new(c[1], c[1] == 0 and 8 or -8, c[2], c[2] == 0 and 8 or -8) }, ghost)
	end

	local target = startPos
	local current = startPos
	local dragging, grab = false, Vector2.zero
	header.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			self.Dragging = true
			grab = Vector2.new(i.Position.X, i.Position.Y) - Vector2.new(win.AbsolutePosition.X, win.AbsolutePosition.Y)
			ghost.Position, ghost.Size, ghost.Visible = UDim2.fromOffset(win.AbsolutePosition.X, win.AbsolutePosition.Y), UDim2.fromOffset(win.AbsoluteSize.X, win.AbsoluteSize.Y), self.SkeletonEnabled
			ghost.BackgroundTransparency = 1
			tween(scale, 0.2, { Scale = 0.985 })
			tween(win, 0.2, { GroupTransparency = 0.18 })
		end
	end)
	conn(UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local vs = gui.AbsoluteSize
			local p = Vector2.new(i.Position.X, i.Position.Y) - grab
			target = Vector2.new(math.clamp(p.X, 0, vs.X - win.AbsoluteSize.X), math.clamp(p.Y, 0, vs.Y - win.AbsoluteSize.Y))
			ghost.Position = UDim2.fromOffset(target.X, target.Y) -- the skeleton snaps to the cursor; the window glides after it
		end
	end))
	conn(UIS.InputEnded:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			self.Dragging = false
			ghost.Visible = false
			tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			tween(win, 0.3, { GroupTransparency = 0 })
		end
	end))
	conn(RunService.RenderStepped:Connect(function(dt)
		local a = 1 - 0.0005 ^ dt -- frame-rate independent glide
		current = (self.Dragging and not self.SkeletonEnabled) and target or current:Lerp(target, a)
		win.Position = UDim2.fromOffset(math.floor(current.X + 0.5), math.floor(current.Y + 0.5))
	end))

	-- ===== resize grip (bottom-right corner) =====
	local sizeTarget, sizeCur = Vector2.new(W, H), Vector2.new(W, H)
	local resizing, rStart, rBase = false, Vector2.zero, Vector2.zero
	local gripSize = isMobile and 44 or 24
	local grip = new("TextButton", {
		Text = "◢", TextSize = isMobile and 20 or 15, Font = Enum.Font.GothamBold, TextColor3 = C.muted, BackgroundTransparency = 1, AutoButtonColor = false,
		Size = UDim2.fromOffset(gripSize, gripSize), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -3, 1, -3), ZIndex = 20,
	}, win)
	grip.MouseEnter:Connect(function() tween(grip, 0.15, { TextColor3 = C.pink, TextSize = 19 }) end)
	grip.MouseLeave:Connect(function() if not resizing then tween(grip, 0.15, { TextColor3 = C.muted, TextSize = 15 }) end end)
	grip.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			resizing, rStart, rBase = true, Vector2.new(i.Position.X, i.Position.Y), sizeTarget
			ghost.Visible = false
		end
	end)
	conn(UIS.InputChanged:Connect(function(i)
		if resizing and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local vs = gui.AbsoluteSize
			local room = vs - Vector2.new(win.AbsolutePosition.X, win.AbsolutePosition.Y)
			local want = rBase + (Vector2.new(i.Position.X, i.Position.Y) - rStart)
			local minW = isMobile and 280 or 500
			local minH = isMobile and 210 or 340
			sizeTarget = Vector2.new(
				math.clamp(want.X, minW, math.max(minW, math.min(room.X, 1100))),
				math.clamp(want.Y, minH, math.max(minH, math.min(room.Y, 760)))
			)
		end
	end))
	conn(UIS.InputEnded:Connect(function(i)
		if resizing and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
			resizing = false
			tween(grip, 0.2, { TextColor3 = C.muted, TextSize = 15 })
		end
	end))
	conn(RunService.RenderStepped:Connect(function(dt)
		if (sizeCur - sizeTarget).Magnitude > 0.3 then
			sizeCur = sizeCur:Lerp(sizeTarget, 1 - 0.0002 ^ dt)
			win.Size = UDim2.fromOffset(math.floor(sizeCur.X + 0.5), math.floor(sizeCur.Y + 0.5))
		end
	end))

	-- ===== search filter =====
	conn(box:GetPropertyChangedSignal("Text"):Connect(function()
		local q = box.Text:lower()
		for _, tab in ipairs(self.Tabs) do
			for _, r in ipairs(tab.Rows) do r.Frame.Visible = q == "" or r.Name:lower():find(q, 1, true) ~= nil end
		end
	end))

	self.Selected = nil
	self:SetVisible(true)
	return self
end

function GlassUI:Select(tab)
	if self.Selected == tab then return end
	for _, t in ipairs(self.Tabs) do
		local on = t == tab
		tween(t.Button, 0.25, { BackgroundTransparency = on and 0.55 or 1 })
		tween(t.Glyph, 0.25, { TextColor3 = on and C.pink or C.muted })
		tween(t.Name, 0.25, { TextColor3 = on and C.text or C.muted })
		if on then
			t.Page.Visible = true
			t.Page.GroupTransparency = 1
			t.Page.Position = UDim2.fromOffset(0, 16)
			tween(t.Page, 0.4, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) })
		elseif t.Page.Visible then
			t.Page.Visible = false
		end
	end
	self.Selected = tab
	self.TitleLabel.Text = tab.Title
	self.TitleGlyph.Text = tab.GlyphText
	self.Indicator.Visible = true
	tween(self.Indicator, 0.35, { Position = UDim2.fromOffset(0, tab.Button.AbsolutePosition.Y - self.Indicator.Parent.AbsolutePosition.Y + 14) }, Enum.EasingStyle.Back)
end

function GlassUI:AddTab(name, glyph)
	local tab = { Title = name, GlyphText = glyph or "•", Rows = {} }
	local btn = new("TextButton", { Size = UDim2.new(1, -16, 0, 50), Text = "", AutoButtonColor = false, BackgroundColor3 = C.card, BackgroundTransparency = 1, LayoutOrder = #self.Tabs + 1 }, self.TabsHolder)
	round(btn, 10)
	tab.Button = btn
	tab.Glyph = new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 4), Text = tab.GlyphText, TextSize = 18, TextColor3 = C.muted, Font = Enum.Font.GothamBold }, btn)
	tab.Name = new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 31), Text = name, TextSize = 10, TextColor3 = C.muted, Font = Enum.Font.GothamMedium }, btn)
	btn.MouseEnter:Connect(function() if self.Selected ~= tab then tween(btn, 0.15, { BackgroundTransparency = 0.82 }) end end)
	btn.MouseLeave:Connect(function() if self.Selected ~= tab then tween(btn, 0.15, { BackgroundTransparency = 1 }) end end)
	btn.MouseButton1Click:Connect(function() self:Select(tab) end)

	local page = new("CanvasGroup", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false }, self.Content)
	local scroll = new("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ScrollBarThickness = 3, ScrollBarImageColor3 = C.pink,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, page)
	new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
	pad(scroll, 0, 2, 6, 6)
	local cols = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 }, scroll)
	new("UIListLayout", { FillDirection = self.IsMobile and Enum.FillDirection.Vertical or Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, cols)
	local function column(order)
		local c = new("Frame", { BackgroundTransparency = 1, Size = self.IsMobile and UDim2.new(1, 0, 0, 0) or UDim2.new(0.5, -4, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order }, cols)
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, c)
		return c
	end
	tab.Page, tab.Scroll, tab.Left, tab.Right = page, scroll, column(1), column(2)
	tab.Ui = self
	table.insert(self.Tabs, setmetatable(tab, { __index = GlassUI.Tab }))
	if #self.Tabs == 1 then task.defer(function() self:Select(tab) end) end
	return tab
end

