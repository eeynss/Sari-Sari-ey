			tween(arrow, 0.2, { Rotation = 0 })
			tween(p.F, 0.18, { GroupTransparency = 1 }).Completed:Once(function() p.Catcher:Destroy() end)
		end
	end
	function obj:Get() return selected end
	function obj:Set(set, silent)
		selected = {}
		for k, v in pairs(set or {}) do selected[k] = v end
		summary()
		if not silent and o.Callback then task.spawn(o.Callback, selected) end
	end
	function obj:SetOptions(list) options = list end
	summary()

	btn.MouseButton1Click:Connect(function()
		if popup then close() return end
		local catcher = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 300, AutoButtonColor = false }, ui.Gui)
		catcher.MouseButton1Click:Connect(close)
