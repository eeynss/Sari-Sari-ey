		glass(f, 10, 0.2, 0.55)
		local searchHolder = new("Frame", { Size = UDim2.new(1, -12, 0, 26), Position = UDim2.fromOffset(6, 6), ZIndex = 302 }, f)
		glass(searchHolder, 7, 0.65, 0.8)
		local box = new("TextBox", { BackgroundTransparency = 1, Size = UDim2.new(1, -12, 1, 0), Position = UDim2.fromOffset(6, 0), PlaceholderText = "search...", Text = "", PlaceholderColor3 = C.muted, TextColor3 = C.text, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, ZIndex = 303 }, searchHolder)
		local sc = new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, -8, 1, -42), Position = UDim2.fromOffset(4, 36), ScrollBarThickness = 2, ScrollBarImageColor3 = C.pink, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 302 }, f)
		new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, sc)
		local buttons = {}
		for i, opt in ipairs(options) do
