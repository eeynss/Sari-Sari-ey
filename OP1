local function doRejoin(reason)
	if rejoining or not alive or not H.AutoRejoin then return end

	-- User requested private-server-only rejoin.
	if H.PrivateServerRejoinOnly and not STARTED_IN_PRIVATE_SERVER then
		H.LastRejoin = "Not rejoining: current server is not private"
		return
	end
	if PRIVATE_JOB_ID == "" then
		H.LastRejoin = "Not rejoining: private server JobId is unavailable"
		return
	end

	rejoining = true
	posState.pending = true
	posState.privateServerId = PRIVATE_SERVER_ID
	posState.jobId = PRIVATE_JOB_ID
	writePos()

	if H.RejoinDryRun then
		H.LastRejoin = "dry run private rejoin: " .. tostring(reason)
		rejoining = false
		posState.pending = nil
		writePos()
		return
	end

	local queue = queue_on_teleport or queueonteleport
	if queue then
		pcall(queue, ('loadstring(game:HttpGet("%s"))()'):format(H.ScriptUrl))
	end

	H.LastRejoin = "Rejoining same private server..."
	task.spawn(function()
		for attempt = 1, 12 do
			if not alive then return end

			-- Same exact private instance. No Teleport(placeId) fallback is used.
			local ok, err = pcall(function()
				TeleportService:TeleportToPlaceInstance(game.PlaceId, PRIVATE_JOB_ID, lp)
			end)

			if not ok then
				H.LastRejoin = ("Private rejoin attempt %d failed: %s"):format(attempt, tostring(err))
			end
			task.wait(8)
		end

		rejoining = false
		H.LastRejoin = "Private server rejoin unavailable; public fallback disabled"
	end)
end
H.TriggerRejoin = doRejoin

