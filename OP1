-- one scan of the plot every 1.5s instead of one per tick: pick prompts (with their active shelf model) and register prompts
local pickCache = { t = 0, pick = {}, reg = {}, slots = {} }
local function scanPrompts(plot)
	if pickCache.plot == plot and os.clock() - pickCache.t < 1.5 then return pickCache end
	local pick, reg, slots = {}, {}, {}
	for _, d in ipairs(plot:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("SlotIndex") ~= nil and d:FindFirstChild("BoxPrompt") then
			if shelfVisible(d) then table.insert(slots, d) end
		elseif d:IsA("ProximityPrompt") then
			if d.Name == "PickPrompt" then
				local m = shelfModelOf(d)
				if m and shelfVisible(m) then table.insert(pick, { prompt = d, model = m }) end
			elseif d.Name == "RegisterPrompt" then
				table.insert(reg, d)
			end
		end
	end
	pickCache.plot, pickCache.t, pickCache.pick, pickCache.reg, pickCache.slots = plot, os.clock(), pick, reg, slots
	return pickCache
end

local function findShelf(plot, productId)
	for _, e in ipairs(scanPrompts(plot).pick) do
		local m = e.model
		if m.Parent and m:GetAttribute("ProductId") == productId and (m:GetAttribute("Stock") or 0) > 0 then
			return e.prompt, m
		end
	end
end

