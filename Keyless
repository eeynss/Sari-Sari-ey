local function deliveryWaiting()
	local plot = myPlot()
	local bay = plot and plot:FindFirstChild("TruckBay")
	if not bay then return false end
	for _, d in ipairs(bay:GetChildren()) do
		if d.Name == "DeliveryBox" and (d:GetAttribute("Count") or 0) > 0 and licenseAllowed(d:GetAttribute("ProductId")) and d:FindFirstChild("PickupPrompt", true) then return true end
	end
	return false
