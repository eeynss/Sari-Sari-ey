-- Licenses: DataConfig.LICENSES = L1..L19 with prices; PurchaseLicense(key) buys one and the server answers with LicenseUpdate(owned
-- keys). Buys the cheapest locked one in order, only when you keep at least H.LicenseReserve pesos afterwards. Money = the
-- PlayerListMoney attribute on you.
local ownedLicenses = {}
table.insert(conns, Remotes.LicenseUpdate.OnClientEvent:Connect(function(owned)
	if type(owned) == "table" then ownedLicenses = owned end
end))

-- The game only tells us the owned licenses when one changes, so work it out from what the Stock Notice and your inventory show:
-- those only list products you are allowed to sell, and licenses unlock in order, so the highest license among them (and every one
-- below it) is yours.
local function syncOwnedLicenses()
	local maxN = 1
	local function consider(id)
		local n = tonumber(tostring(licenseOf(id)):match("%d+"))
		if n and n > maxN then maxN = n end
	end
	pcall(function()
		local rep = Remotes.GetStockReport:InvokeServer()
		for _, group in ipairs({ rep.outOfStock or {}, rep.lowStock or {} }) do
			for _, it in ipairs(group) do consider(it.id) end
		end
	end)
	pcall(function()
		for id in pairs(Remotes.GetInventoryCounts:InvokeServer()) do consider(id) end
	end)
	for n = 1, maxN do ownedLicenses["L" .. n] = true end
	return maxN
end
task.spawn(function()
	local skipLic = {}
	while alive do
		task.wait(6)
		syncOwnedLicenses()
		local money = tonumber(lp:GetAttribute("PlayerListMoney")) or 0
		local nextLic
		for _, lic in ipairs(DataConfig.LICENSES) do
			if lic.price > 0 and not ownedLicenses[lic.key] and not skipLic[lic.key] then nextLic = lic break end
		end
		if H.OnLicense then
			H.OnLicense(nextLic and ("Next: %s  (P%d)  |  you have P%d"):format(nextLic.key, nextLic.price, money) or "No locked licenses left (or all tried).")
		end
		if H.AutoLicense and nextLic and money >= nextLic.price + (H.LicenseReserve or 0) then
			Remotes.PurchaseLicense:FireServer(nextLic.key)
			stats.actions += 1
			onStats()
			task.wait(3)
			if not ownedLicenses[nextLic.key] then -- no update came back: probably already owned or refused; look again in 5 min
				skipLic[nextLic.key] = true
				task.delay(300, function() skipLic[nextLic.key] = nil end)
			end
		end
	end
end)

-- Buy one box of every item you are allowed to sell. Unlocked = its license (DataConfig.PRODUCT_LICENSE) is L1 or owned.
-- Cost of a box = buy price x boxSize. Cheapest first, only as many as fit in (your cash - reserve). onlyLow = skip items you
-- already hold at least a box of. The delivery then lands in the truck bay and the pickup/restock loops do the rest.
local function buyOneOfEach(onlyLow)
	syncOwnedLicenses()
	local money = tonumber(lp:GetAttribute("PlayerListMoney")) or 0
	local budget = money - (H.LicenseReserve or 0)
	local counts = {}
	if onlyLow then
		local ok, c = pcall(function() return Remotes.GetInventoryCounts:InvokeServer() end)
		if ok and type(c) == "table" then counts = c end
	end
	local list = {}
	for _, def in ipairs(DataConfig.PRODUCTS or {}) do
		local lic = (DataConfig.PRODUCT_LICENSE and DataConfig.PRODUCT_LICENSE[def.id]) or (DataConfig.RICE_PRODUCT_LICENSE and DataConfig.RICE_PRODUCT_LICENSE[def.id]) or "L1"
		local unlocked = lic == "L1" or ownedLicenses[lic]
		local box = def.boxSize or 1
		if def.id and def.buy and unlocked and (not onlyLow or (counts[def.id] or 0) < box) then
			table.insert(list, { id = def.id, cost = def.buy * box })
		end
	end
	table.sort(list, function(a, b) return a.cost < b.cost end)
	local order, spent = {}, 0
	for _, it in ipairs(list) do
		if spent + it.cost <= budget then
			table.insert(order, { id = it.id, qty = 1 })
			spent += it.cost
		end
	end
	if #order == 0 then return 0, #list, 0 end
	Remotes.PurchaseOrder:FireServer(order)
	stats.actions += 1
	onStats()
	return #order, #list, spent
end
H.BuyOneOfEach = buyOneOfEach

-- what ordering one box of EVERY unlocked item would cost (ignores your cash), for the label in the Shop tab
function H.QuoteEach()
	syncOwnedLicenses()
	local total, n = 0, 0
	for _, def in ipairs(DataConfig.PRODUCTS or {}) do
		local lic = (DataConfig.PRODUCT_LICENSE and DataConfig.PRODUCT_LICENSE[def.id]) or (DataConfig.RICE_PRODUCT_LICENSE and DataConfig.RICE_PRODUCT_LICENSE[def.id]) or "L1"
		if def.id and def.buy and (lic == "L1" or ownedLicenses[lic]) then
			total += def.buy * (def.boxSize or 1)
			n += 1
		end
	end
	return total, n
end

