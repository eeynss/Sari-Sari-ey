	if fsOk then pcall(function() writefile(ROOT .. "/autoload.txt", "") end) autoName = "none" status() end
end })
cfgName:AddButton({ Name = "Rename selected to typed name", Callback = function()
	local old, new = cfgDrop:Get(), cleanName(nameInput:Get())
	if fsOk and old ~= "-" and new ~= "" and type(delfile) == "function" then
		local ok = pcall(function() writefile(pathOf(new), readfile(pathOf(old))) delfile(pathOf(old)) end)
		if ok then if loadedName == old then loadedName = new end if autoName == old then autoName = new pcall(function() writefile(ROOT .. "/autoload.txt", new) end) end refresh(new) status() end
	end
end })
cfgName:AddButton({ Name = "Reset all settings to default", Callback = function()
	applyData({ H = DEFAULTS, theme = { preset = "Sakura", transparent = false, skeleton = true, scale = 100 } })
	loadedName = "none"
	status()
end })
cfgName:AddButton({ Name = "Refresh list", Callback = function() refresh() end })

local share = settings:AddSection("Share", "right", "🔗")
local pasteInput = share:AddInput({ Name = "Paste a config code", Placeholder = "paste code..." })
share:AddButton({ Name = "Copy code (current settings)", Callback = function()
	if setclipboard then setclipboard(HttpService:JSONEncode(snapshot())) cfgStatus:Set("Config code copied.") end
end })
share:AddButton({ Name = "Import code", Callback = function()
	local ok, data = pcall(function() return HttpService:JSONDecode(pasteInput:Get()) end)
	cfgStatus:Set((ok and applyData(data)) and "Imported the pasted config." or "That code is not valid.")
end })

refresh()
if fsOk and type(isfile) == "function" then
	pcall(function()
		if isfile(ROOT .. "/autoload.txt") then
			local n = readfile(ROOT .. "/autoload.txt"):gsub("%s+", "")
			if n ~= "" and isfile(pathOf(n)) then
				autoName = n
				local ok, data = pcall(function() return HttpService:JSONDecode(readfile(pathOf(n))) end)
				if ok and applyData(data) then loadedName = n end
				refresh(n)
			end
		end
	end)
end
status()

print("[Eynch] loaded")
end
