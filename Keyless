-- dropdown: popup list drawn above the window; obj:SetOptions(list), obj:Set(value), obj:Get()
function Section:AddDropdown(o)
	local row = self:_row(o.Name, 30)
	local ui = self.Tab.Ui
	local name = label(row, o.Name, 12, C.text, false)
	name.Size = UDim2.new(0.42, 0, 1, 0)
	local btn = new("TextButton", { Size = UDim2.new(0.58, 0, 1, -4), Position = UDim2.new(0.42, 0, 0, 2), Text = "", AutoButtonColor = false }, row)
	glass(btn, 8, 0.7, 0.8)
	local cur = label(btn, "", 12, C.text, false)
	cur.Size, cur.Position = UDim2.new(1, -28, 1, 0), UDim2.fromOffset(9, 0)
	local arrow = new("TextLabel", { BackgroundTransparency = 1, Text = "▾", TextSize = 14, TextColor3 = C.muted, Font = Enum.Font.GothamBold, Size = UDim2.fromOffset(20, 26), Position = UDim2.new(1, -22, 0, 0) }, btn)
	local options, value = o.Options or {}, o.Default
	local obj = {}
	local popup
	local function close()
		if popup then
			local p = popup
			popup = nil
			tween(arrow, 0.2, { Rotation = 0 })
			tween(p.F, 0.18, { GroupTransparency = 1 }).Completed:Once(function() p.Catcher:Destroy() end)
		end
	end
	function obj:Get() return value end
	function obj:Set(v, silent)
		value = v
		cur.Text = tostring(v or "-")
		if o.Flag then ui.Flags[o.Flag] = v end
		if not silent and o.Callback then task.spawn(o.Callback, v) end
	end
	function obj:SetOptions(list, keep)
		options = list
		if not keep then obj:Set(list[1], true) end
	end
	obj:Set(value, true)
	btn.MouseButton1Click:Connect(function()
		if popup then close() return end
		local catcher = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 300, AutoButtonColor = false }, ui.Gui)
		catcher.MouseButton1Click:Connect(close)
		local rows = math.min(#options, 6)
		local f = new("CanvasGroup", { Size = UDim2.fromOffset(btn.AbsoluteSize.X, rows * 26 + 8), Position = UDim2.fromOffset(btn.AbsolutePosition.X, btn.AbsolutePosition.Y + btn.AbsoluteSize.Y + 4), GroupTransparency = 1, ZIndex = 301 }, catcher)
		glass(f, 10, 0.2, 0.55)
		local sc = new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, -8, 1, -8), Position = UDim2.fromOffset(4, 4), ScrollBarThickness = 2, ScrollBarImageColor3 = C.pink, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 302 }, f)
		new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, sc)
		for i, opt in ipairs(options) do
			local b = new("TextButton", { Size = UDim2.new(1, -4, 0, 26), Text = tostring(opt), Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = opt == value and C.pink or C.text, BackgroundColor3 = C.card, BackgroundTransparency = 1, AutoButtonColor = false, LayoutOrder = i, ZIndex = 303 }, sc)
			round(b, 7)
			pad(b, 8, 0)
			b.MouseEnter:Connect(function() tween(b, 0.1, { BackgroundTransparency = 0.8 }) end)
			b.MouseLeave:Connect(function() tween(b, 0.1, { BackgroundTransparency = 1 }) end)
			b.MouseButton1Click:Connect(function() obj:Set(opt) close() end)
		end
		popup = { F = f, Catcher = catcher }
		tween(f, 0.18, { GroupTransparency = 0 })
		tween(arrow, 0.2, { Rotation = 180 })
	end)
	if o.Flag then ui.Elements[o.Flag] = obj end
	return obj
end

-- keybind: click, then press a key (Esc cancels). Callback(KeyCode)
function Section:AddKeybind(o)
	local row = self:_row(o.Name, 30)
	local name = label(row, o.Name, 12, C.text, false)
	name.Size = UDim2.new(0.6, 0, 1, 0)
	local btn = new("TextButton", { Size = UDim2.fromOffset(86, 24), Position = UDim2.new(1, -86, 0.5, -12), Text = "", AutoButtonColor = false }, row)
	glass(btn, 8, 0.7, 0.8)
	local txt = new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = C.muted }, btn)
	local key = o.Default
	local obj = {}
	local function show() txt.Text = key and key.Name or "None" end
	function obj:Set(k, silent)
		key = k
		show()
		if not silent and o.Callback then task.spawn(o.Callback, k) end
	end
	show()
	btn.MouseButton1Click:Connect(function()
		txt.Text = "press a key..."
		txt.TextColor3 = C.pink
		local c
		c = UIS.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.Keyboard then
				c:Disconnect()
				txt.TextColor3 = C.muted
				if i.KeyCode ~= Enum.KeyCode.Escape then obj:Set(i.KeyCode) else show() end
			end
		end)
	end)
	return obj
end

-- multi-select dropdown: the popup stays open while you tick several options; it has a search box.
-- o.Options = list of strings, o.Selected = set { [option] = true }, o.Callback(set). obj:Get() -> set, obj:Set(set, silent).
function Section:AddMultiDropdown(o)
	local row = self:_row(o.Name, 30)
	local ui = self.Tab.Ui
	local name = label(row, o.Name, 12, C.text, false)
	name.Size = UDim2.new(0.42, 0, 1, 0)
	local btn = new("TextButton", { Size = UDim2.new(0.58, 0, 1, -4), Position = UDim2.new(0.42, 0, 0, 2), Text = "", AutoButtonColor = false }, row)
	glass(btn, 8, 0.7, 0.8)
	local cur = label(btn, "", 12, C.text, false)
	cur.Size, cur.Position = UDim2.new(1, -28, 1, 0), UDim2.fromOffset(9, 0)
	local arrow = new("TextLabel", { BackgroundTransparency = 1, Text = "▾", TextSize = 14, TextColor3 = C.muted, Font = Enum.Font.GothamBold, Size = UDim2.fromOffset(20, 26), Position = UDim2.new(1, -22, 0, 0) }, btn)
	local options, selected = o.Options or {}, {}
	for k, v in pairs(o.Selected or {}) do selected[k] = v end
	local obj = {}
	local popup

	local function summary()
		local n, first = 0, nil
		for k in pairs(selected) do n += 1 first = first or k end
		cur.Text = n == 0 and "None selected" or (n == 1 and first or (n .. " selected"))
	end
	local function close()
		if popup then
			local p = popup
			popup = nil
			tween(arrow, 0.2, { Rotation = 0 })
			tween(p.F, 0.18, { GroupTransparency = 1 }).Completed:Once(function() p.Catcher:Destroy() end)
		end
	end
	function obj:Get() return selected end
	function obj:Set(set, silent)
		selected = {}
		for k, v in pairs(set or {}) do selected[k] = v end
		summary()
		if not silent and o.Callback then task.spawn(o.Callback, selected) end
	end
	function obj:SetOptions(list) options = list end
	summary()

	btn.MouseButton1Click:Connect(function()
		if popup then close() return end
		local catcher = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 300, AutoButtonColor = false }, ui.Gui)
		catcher.MouseButton1Click:Connect(close)
		local rows = math.min(#options, 8)
		local height = 38 + rows * 26 + 8
		local x, y = btn.AbsolutePosition.X, btn.AbsolutePosition.Y + btn.AbsoluteSize.Y + 4
		if y + height > ui.Gui.AbsoluteSize.Y then y = math.max(4, btn.AbsolutePosition.Y - height - 4) end
		local f = new("CanvasGroup", { Size = UDim2.fromOffset(math.max(btn.AbsoluteSize.X, 240), height), Position = UDim2.fromOffset(x, y), GroupTransparency = 1, ZIndex = 301 }, catcher)
		glass(f, 10, 0.2, 0.55)
		local searchHolder = new("Frame", { Size = UDim2.new(1, -12, 0, 26), Position = UDim2.fromOffset(6, 6), ZIndex = 302 }, f)
		glass(searchHolder, 7, 0.65, 0.8)
		local box = new("TextBox", { BackgroundTransparency = 1, Size = UDim2.new(1, -12, 1, 0), Position = UDim2.fromOffset(6, 0), PlaceholderText = "search...", Text = "", PlaceholderColor3 = C.muted, TextColor3 = C.text, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, ZIndex = 303 }, searchHolder)
		local sc = new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, -8, 1, -42), Position = UDim2.fromOffset(4, 36), ScrollBarThickness = 2, ScrollBarImageColor3 = C.pink, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 302 }, f)
		new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, sc)
		local buttons = {}
		for i, opt in ipairs(options) do
			local b = new("TextButton", { Size = UDim2.new(1, -4, 0, 26), Text = "", BackgroundColor3 = C.card, BackgroundTransparency = 1, AutoButtonColor = false, LayoutOrder = i, ZIndex = 303 }, sc)
			round(b, 7)
			local mark = new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(22, 26), Position = UDim2.fromOffset(6, 0), Font = Enum.Font.GothamBold, TextSize = 13, ZIndex = 304 }, b)
			local txt = new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, -34, 1, 0), Position = UDim2.fromOffset(30, 0), Text = tostring(opt), Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 304 }, b)
			local function paint()
				local on = selected[opt] == true
				mark.Text = on and "✓" or ""
				mark.TextColor3 = C.pink
				txt.TextColor3 = on and C.pink or C.text
			end
			paint()
			b.MouseEnter:Connect(function() tween(b, 0.1, { BackgroundTransparency = 0.8 }) end)
			b.MouseLeave:Connect(function() tween(b, 0.1, { BackgroundTransparency = 1 }) end)
			b.MouseButton1Click:Connect(function()
				selected[opt] = (not selected[opt]) or nil
				paint()
				summary()
				if o.Callback then task.spawn(o.Callback, selected) end
			end)
			buttons[b] = opt
		end
		box:GetPropertyChangedSignal("Text"):Connect(function()
			local q = box.Text:lower()
			for b, opt in pairs(buttons) do b.Visible = q == "" or tostring(opt):lower():find(q, 1, true) ~= nil end
		end)
		popup = { F = f, Catcher = catcher }
		tween(f, 0.18, { GroupTransparency = 0 })
		tween(arrow, 0.2, { Rotation = 180 })
	end)
	return obj
end

-- ===== theme / window settings =====
local function near(a, b) return math.abs(a.R - b.R) < 0.012 and math.abs(a.G - b.G) < 0.012 and math.abs(a.B - b.B) < 0.012 end

function GlassUI:SetTheme(a, b)
	local old1, old2 = C.pink, C.pink2
	C.pink, C.pink2 = a, b
	local props = { "BackgroundColor3", "TextColor3", "ImageColor3", "ScrollBarImageColor3" }
	for _, d in ipairs(self.Gui:GetDescendants()) do
		for _, pr in ipairs(props) do
			local ok, v = pcall(function() return d[pr] end)
			if ok and typeof(v) == "Color3" then
				if near(v, old1) then d[pr] = a elseif near(v, old2) then d[pr] = b end
			end
		end
		if d:IsA("UIStroke") then
			if near(d.Color, old1) then d.Color = a elseif near(d.Color, old2) then d.Color = b end
		elseif d:IsA("UIGradient") and d.Color.Keypoints[1] and near(d.Color.Keypoints[1].Value, old1) then
			d.Color = ColorSequence.new(a, b)
		end
	end
end

function GlassUI:SetScale(n) tween(self.UserScale, 0.25, { Scale = n }) end
function GlassUI:SetTransparent(on) tween(self.Win, 0.3, { BackgroundTransparency = on and 0.55 or 0.28 }) end
function GlassUI:SetSkeleton(on) self.SkeletonEnabled = on and true or false end
function GlassUI:SetToggleKey(k) self.ToggleKey = k end


function GlassUI:Destroy()
	for _, c in ipairs(self.Conns) do c:Disconnect() end
