end

function Section:_row(name, h)
	self.Count += 1
	local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, h or 28), LayoutOrder = self.Count }, self.Card)
	table.insert(self.Tab.Rows, { Frame = row, Name = name })
