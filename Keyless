-- Auto buy from the Stock Notice: GetStockReport is exactly what that popup shows (outOfStock / lowStock lists, with `box` = boxes you
-- own of that item). Every item with nothing on the shelf and no box in your bag gets H.AutoBuyQty boxes, cheapest first, only as
-- many as your cash allows after the reserve. Checks every few seconds, orders at most once per 45 seconds.
task.spawn(function()
	local lastBuy = 0
	while alive do
		task.wait(5)
		if H.AutoBuy and os.clock() - lastBuy > 45 then
			local ok, rep = pcall(function() return Remotes.GetStockReport:InvokeServer() end)
			if ok and type(rep) == "table" then
				local money = tonumber(lp:GetAttribute("PlayerListMoney")) or 0
				local budget = money - (H.LicenseReserve or 0)
				local want = {}
				for _, group in ipairs({ rep.outOfStock or {}, rep.lowStock or {} }) do
					for _, it in ipairs(group) do
						if (it.box or 0) <= 0 and H.AutoBuyItems[it.id] then -- only the items you picked
							local def = DataConfig.getProduct(it.id)
							local per = def and def.buy and (def.buy * (def.boxSize or 1)) or 0
							table.insert(want, { id = it.id, cost = per * (H.AutoBuyQty or 1) })
						end
					end
				end
				table.sort(want, function(a, b) return a.cost < b.cost end)
				local order, spent = {}, 0
				for _, w in ipairs(want) do
					if spent + w.cost <= budget then
						table.insert(order, { id = w.id, qty = H.AutoBuyQty or 1 })
						spent += w.cost
					end
				end
				if #order > 0 then
					lastBuy = os.clock()
					Remotes.PurchaseOrder:FireServer(order)
					stats.actions += 1
					onStats()
					if H.OnPurchase then H.OnPurchase(("Auto-ordered %d box(es) each of %d item(s) for P%d"):format(H.AutoBuyQty or 1, #order, spent)) end
				end
			end
		end
	end
end)

-- Auto claim finished daily tasks (GetDailyTasks returns {tasks = {{kind, done, claimed}}}; ClaimTask takes the kind).
task.spawn(function()
	while alive do
		task.wait(5)
		if H.AutoClaimTasks then
			local ok, res = pcall(function() return Remotes.GetDailyTasks:InvokeServer() end)
			if ok and type(res) == "table" and type(res.tasks) == "table" then
				for _, t in ipairs(res.tasks) do
					if t.done and not t.claimed then
						Remotes.ClaimTask:FireServer(t.kind)
						stats.actions += 1
						onStats()
						task.wait(1)
					end
				end
			end
		end
	end
end)

