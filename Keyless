function GlassUI.Tab:AddSection(titleText, side, glyph)
	local parent = side == "right" and self.Right or side == "left" and self.Left or self.Scroll
	local card = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = side == "full" and 2 or 1 }, parent)
	glass(card, 12, 0.62, 0.82)
	pad(card, 10, 8)
	local list = new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, card)
	local head = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 0 }, card)
	local gl = label(head, glyph or "✦", 14, C.pink, true)
	gl.Size = UDim2.fromOffset(22, 22)
	local t = label(head, titleText, 13, C.text, true)
	t.Size, t.Position = UDim2.new(1, -26, 1, 0), UDim2.fromOffset(24, 0)
	local sec = setmetatable({ Card = card, Tab = self, Count = 0 }, Section)
